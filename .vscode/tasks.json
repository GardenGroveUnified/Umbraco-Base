{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-and-build",
            "dependsOn": ["kill-dotnet-and-port", "build"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label":"kill-dotnet-and-port",
            "type":"shell",
            "command":"pkill -f dotnet; lsof -ti:44389 | xargs kill -9; exit 0",
            "problemMatcher": []
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/UmbracoBase.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/UmbracoBase.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/UmbracoBase.sln"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}