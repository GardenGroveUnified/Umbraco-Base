@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Page>
@using Umbraco.Cms.Web.Common.PublishedModels;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models.Blocks;

@{
    Layout = "Master.cshtml";

    var title = string.IsNullOrWhiteSpace(Model.Value<string>("pageTitle")) ? Model.Name : Model.Value<string>("pageTitle");
    ViewBag.Title = $"{title} | GGUSD Athletics";
    var hasSidebar = Model is not null && Model.AncestorsOrSelf()
        .Any(p => p.Value<IEnumerable<BlockListItem>>("sidebarBlocks")?.Any() == true);
}

@{
    var parentPage = Model != null ? Model.Parent<IPublishedContent>() : null;

    if (Model?.ShowParent == true)
    {
        var parentHeaderBlocks = parentPage?.Value<IEnumerable<BlockListItem>>("headerBlocks");
        var parentBlocks = parentPage?.Value<IEnumerable<BlockListItem>>("Blocks");

        @if (parentHeaderBlocks != null && parentHeaderBlocks.Any())
        {
            <div class="parent-blocks">
                @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                {
                    { "Blocks", parentHeaderBlocks },
                    { "ParentPage", parentPage }
                })
            </div>
        }

        @if (parentBlocks != null && parentBlocks.Any())
        {
            <div class="parent-blocks">
                @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                {
                    { "Blocks", parentBlocks },
                    { "ParentPage", parentPage }
                })
            </div>
        }
    }

    @if (Model!.HeaderBlocks!.Any())
    {
        <div class="container-xxl">
            @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
            {
                { "Blocks", Model.HeaderBlocks }
            })
        </div>
    }

    @if (Model?.PageTitle is not null && Model?.PageTitle != "")
    {
        <div class="container">
            <h1 class="mt-5 mb-3 text-blue">@Model!.PageTitle</h1>
        </div>
    }

    @* --- Quick actions bar --- *@
    <div class="athletics-quickactions">
        @{
            var quickActions = new (string Label, string Url)[]
            {
                ("Athletic Clearance", "#"),
                ("Schedules", "#"),
                ("Sports Demographics", "#"),
                ("Summer Sports", "#"),
                ("Athletic Staff", "#"),
            };
        }
        @for (var i = 0; i < quickActions.Length; i++)
        {
            <a href="@quickActions[i].Url" class="athletics-quickactions__item @(i == 0 ? "athletics-quickactions__item--active" : "")">@quickActions[i].Label</a>
        }
    </div>

    @if (hasSidebar)
    {
        <div class="container">
            <div class="row">
                @if (Model!.Blocks!.Any())
                {
                    <div class="col-12 col-md">
                        @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                        {
                            { "Blocks", Model.Blocks }
                        })
                    </div>
                }
                <div class="col-12 col-md-4 col-lg-3 my-4 my-md-5">
                    @await Html.PartialAsync("~/Views/Partials/Widgets/Sidebar/desktopSidebar.cshtml")
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model!.Blocks!.Any())
        {
            <div class="container">
                @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                {
                    { "Blocks", Model.Blocks }
                })
            </div>
        }
    }

    @* --- Featured Sport ---
         Placeholder content until a real "featured sport" content type exists;
         edit the values below directly, or replace with real CMS data later.
         The schedule that used to live next to this is now the real,
         backoffice-editable Athletics Schedule widget below (in Model.Blocks). *@
    <div class="athletics-featured-standalone">
        <div class="home-section-title">
            <div class="home-section-title__label">
                <span class="home-section-title__bar"></span>
                Featured Sport
            </div>
            <a href="#" class="home-section-title__action">View roster &rarr;</a>
        </div>
        <div class="athletics-featured">
            <div class="athletics-featured__photo"></div>
            <div>
                <div class="athletics-featured__title">Boys Varsity Soccer</div>
                <div class="athletics-featured__meta">Coach: Mr. Rodriguez &middot; Spring 2026</div>
                <div class="athletics-featured__meta">Empire League &middot; Home: Santiago Stadium</div>
            </div>
        </div>
        <div class="athletics-featured__stats">
            @{
                var stats = new (string Label, string Value)[] { ("Wins", "8"), ("Losses", "3"), ("Ties", "1") };
            }
            @foreach (var stat in stats)
            {
                <div class="athletics-featured__stat">
                    <div class="athletics-featured__stat-value">@stat.Value</div>
                    <div class="athletics-featured__stat-label">@stat.Label</div>
                </div>
            }
        </div>
    </div>

    @* --- Athletic Clearance CTA band --- *@
    <div class="athletics-clearance-cta">
        <span style="font-size:20px;">&#128203;</span>
        <div>
            <div class="athletics-clearance-cta__title">Ready to play? Get your Athletic Clearance first.</div>
            <div class="athletics-clearance-cta__text">All student athletes must complete clearance before tryouts. Deadline: Aug 1, 2026.</div>
        </div>
        <div class="flex-grow-1"></div>
        <a href="#" class="btn" style="background:var(--shs-purple); color:#fff;">Get Cleared &rarr;</a>
    </div>
}