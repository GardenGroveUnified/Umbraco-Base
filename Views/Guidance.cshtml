@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Page>
@using Umbraco.Cms.Web.Common.PublishedModels;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models.Blocks;

@{
    Layout = "Master.cshtml";

    var title = string.IsNullOrWhiteSpace(Model.Value<string>("pageTitle")) ? Model.Name : Model.Value<string>("pageTitle");
    ViewBag.Title = $"{title} | GGUSD Guidance & Counseling";
    var hasSidebar = Model?.SidebarBlocks?.Count > 0;
}

@{
    var parentPage = Model != null ? Model.Parent<IPublishedContent>() : null;

    if (Model?.ShowParent == true)
    {
        var parentHeaderBlocks = parentPage?.Value<IEnumerable<BlockListItem>>("headerBlocks");
        var parentBlocks = parentPage?.Value<IEnumerable<BlockListItem>>("Blocks");

        @if (parentHeaderBlocks != null && parentHeaderBlocks.Any())
        {
            <div class="parent-blocks">
                @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                {
                    { "Blocks", parentHeaderBlocks },
                    { "ParentPage", parentPage }
                })
            </div>
        }

        @if (parentBlocks != null && parentBlocks.Any())
        {
            <div class="parent-blocks">
                @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                {
                    { "Blocks", parentBlocks },
                    { "ParentPage", parentPage }
                })
            </div>
        }
    }

    @if (Model!.HeaderBlocks!.Any())
    {
        <div class="container-xxl">
            @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
            {
                { "Blocks", Model.HeaderBlocks }
            })
        </div>
    }

    @if (Model?.PageTitle is not null && Model?.PageTitle != "")
    {
        <div class="container">
            <h1 class="my-5 text-blue">@Model!.PageTitle</h1>
        </div>
    }

    @* --- Quick resource pills --- *@
    <div class="guidance-pills">
        <span class="guidance-pills__label">Jump to:</span>
        @{
            var jumpLinks = new (string Label, string Url)[]
            {
                ("Counselors", "#counselors"),
                ("College Planning", "#college-planning"),
                ("AP/SAT Info", "#"),
                ("Scholarships", "#"),
                ("Transcripts", "#"),
                ("Financial Aid", "#"),
            };
        }
        @foreach (var link in jumpLinks)
        {
            <a href="@link.Url" class="guidance-pills__item">@link.Label</a>
        }
    </div>

    @if (hasSidebar)
    {
        <div class="container">
            <div class="row">
                @if (Model!.Blocks!.Any())
                {
                    <div class="col">
                        @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                        {
                            { "Blocks", Model.Blocks }
                        })
                    </div>
                }
                <div class="col-md-3 my-5 d-md-block d-none">
                    @await Html.PartialAsync("~/Views/Partials/Widgets/Sidebar/desktopSidebar.cshtml")
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model!.Blocks!.Any())
        {
            <div class="container">
                @await Html.PartialAsync("~/Views/Partials/Widgets/RenderBlocks.cshtml", new ViewDataDictionary(ViewData)
                {
                    { "Blocks", Model.Blocks }
                })
            </div>
        }
    }

    @* --- Counselor cards ---
         Placeholder content until a real Staff content type exists; edit the
         values below directly, or replace with real CMS data later. *@
    <div class="guidance-counselors" id="counselors">
        <div class="home-section-title">
            <div class="home-section-title__label">
                <span class="home-section-title__bar"></span>
                Your Counselors
            </div>
            <a href="#" class="home-section-title__action">Contact guidance &rarr;</a>
        </div>
        <div class="guidance-counselors__grid">
            @{
                var counselors = new (string Alpha, string Name)[]
                {
                    ("A – F", "Ms. Martinez"),
                    ("G – L", "Mr. Johnson"),
                    ("M – R", "Ms. Chen"),
                    ("S – Z", "Mr. Williams"),
                };
            }
            @foreach (var counselor in counselors)
            {
                <div class="guidance-counselor">
                    <div class="guidance-counselor__photo"></div>
                    <div class="guidance-counselor__body">
                        <span class="guidance-counselor__alpha">Last names @counselor.Alpha</span>
                        <div class="guidance-counselor__name">@counselor.Name</div>
                        <div class="guidance-counselor__role">School Counselor</div>
                        <a href="#" class="guidance-counselor__email">Email &rarr;</a>
                    </div>
                </div>
            }
        </div>
    </div>

    @* --- College Planning timeline + Resources grid ---
         Placeholder content; edit directly or wire up to real CMS data later. *@
    <div class="guidance-college-resources" id="college-planning">
        <div class="guidance-college-resources__col guidance-college-resources__col--timeline">
            <div class="home-section-title">
                <div class="home-section-title__label">
                    <span class="home-section-title__bar"></span>
                    College Planning
                </div>
                <a href="#" class="home-section-title__action">All resources &rarr;</a>
            </div>
            @{
                var timeline = new (string Grade, string[] Items)[]
                {
                    ("9th", new[] { "4-year plan", "Explore interests" }),
                    ("10th", new[] { "PSAT prep", "Visit colleges" }),
                    ("11th", new[] { "SAT / ACT", "College list" }),
                    ("12th", new[] { "Applications", "Financial Aid" }),
                };
            }
            @for (var i = 0; i < timeline.Length; i++)
            {
                var row = timeline[i];
                <div class="guidance-timeline-row">
                    <div class="guidance-timeline-row__badge @(i == timeline.Length - 1 ? "guidance-timeline-row__badge--current" : "")">@row.Grade</div>
                    <div>
                        @foreach (var item in row.Items)
                        {
                            <div class="guidance-timeline-row__item">
                                <span class="guidance-timeline-row__dot"></span>
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="guidance-college-resources__col guidance-college-resources__col--resources">
            <div class="home-section-title">
                <div class="home-section-title__label">
                    <span class="home-section-title__bar"></span>
                    Resources &amp; Forms
                </div>
                <a href="#" class="home-section-title__action">View all &rarr;</a>
            </div>
            <div class="guidance-resource-grid">
                @{
                    var resources = new[]
                    {
                        "College Entrance Req.", "AP Testing Info", "SAT & ACT Info",
                        "Course Registration", "Financial Aid", "Graduation Req.",
                        "Scholarships", "Transcript Request", "Grade Reports",
                    };
                }
                @foreach (var resource in resources)
                {
                    <div class="guidance-resource-chip">
                        <span class="guidance-resource-chip__dot"></span>
                        <span>@resource</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* --- Upcoming College Events --- *@
    <div class="guidance-events">
        <div class="home-section-title">
            <div class="home-section-title__label">
                <span class="home-section-title__bar"></span>
                Upcoming College Events
            </div>
            <a href="#" class="home-section-title__action">View calendar &rarr;</a>
        </div>
        <div class="guidance-events__row">
            @{
                var collegeEvents = new (string Day, string Month, string Title, string Sub)[]
                {
                    ("5", "MAY", "College Rep: UC Irvine Visit", "10:00 AM · Guidance Office"),
                    ("12", "MAY", "Financial Aid Information Night", "6:00 PM · Cafeteria"),
                    ("19", "MAY", "Senior Info Night 2026", "6:30 PM · Auditorium"),
                    ("27", "MAY", "Grad Ceremony Rehearsal", "9:00 AM · Football Field"),
                };
            }
            @for (var i = 0; i < collegeEvents.Length; i++)
            {
                var ev = collegeEvents[i];
                <div class="guidance-event-card @(i == 0 ? "guidance-event-card--next" : "")">
                    <div class="guidance-event-card__datebadge">
                        <div class="guidance-event-card__day">@ev.Day</div>
                        <span class="guidance-event-card__month">@ev.Month</span>
                    </div>
                    <div class="guidance-event-card__title">@ev.Title</div>
                    <div class="guidance-event-card__sub">@ev.Sub</div>
                </div>
            }
        </div>
    </div>
}