@using Umbraco.Cms.Web.Common.PublishedModels;

@{
	Layout = null;
}

<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
	<meta charset="utf-8">
	@await Html.PartialAsync("~/Views/Partials/Shared/metadata.cshtml")
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="color-scheme" content="light">
	<meta name="theme-color" content="#4a1f7a">
	<!--[if IE]><meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'><![endif]-->
	<!-- up to 10% speed up for external res -->
	<link rel="dns-prefetch" href="https://fonts.googleapis.com/">
	<link rel="dns-prefetch" href="https://fonts.gstatic.com/">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<!-- preloading icon font is helping to speed up a little bit -->
	<link rel="preload" href="~/assets/fonts/flaticon/Flaticon.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="~/assets/fonts/fontawesome/fontawesome-webfont.woff2?v=4.7.0" as="font" type="font/woff2" crossorigin>
	@* Google Fonts. These were @import rules at the top of styles.css. They
	   moved here because WebOptimizer concatenates styles.css into the middle
	   of the bundle, where a browser ignores @import. *@
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Yeseva+One&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Playwrite+AU+NSW:wght@100..400&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

	@* All local site CSS, combined and minified by WebOptimizer.
	   Source order lives in Core/Bundling/StylesheetBundle.cs. *@
	<link rel="stylesheet" href="/css/site.bundle.css" />

	<!-- favicon -->
	<link rel="shortcut icon" href="/favicon.ico">
	</head>

	<body class="header-sticky header-fixed" data-aos-easing="ease-in-out-sine" data-aos-duration="700" data-aos-delay="0">
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<div id="wrapper">
			@await Html.PartialAsync("~/Views/Partials/Shared/header.cshtml")
			<main id="main-content" tabindex="-1" class="main-content position-relative">
				@RenderBody()
			</main>
			@await Html.PartialAsync("~/Views/Partials/Shared/footer.cshtml")
		</div>
		<!-- /#wrapper -->

		<!-- PhotoSwipe root (shared by all Photo Swiper widgets on the page) -->
		<div class="pswp" tabindex="-1" role="dialog" aria-hidden="true">
			<div class="pswp__bg"></div>
			<div class="pswp__scroll-wrap">
				<div class="pswp__container">
					<div class="pswp__item"></div>
					<div class="pswp__item"></div>
					<div class="pswp__item"></div>
				</div>
				<div class="pswp__ui pswp__ui--hidden">
					<div class="pswp__top-bar">
						<div class="pswp__counter"></div>
						<button class="pswp__button pswp__button--close" title="Close (Esc)" aria-label="Close (Esc)"></button>
						<button class="pswp__button pswp__button--fs" title="Toggle fullscreen" aria-label="Toggle fullscreen"></button>
						<button class="pswp__button pswp__button--zoom" title="Zoom in/out" aria-label="Zoom in/out"></button>
						<div class="pswp__preloader">
							<div class="pswp__preloader__icn">
								<div class="pswp__preloader__cut">
									<div class="pswp__preloader__donut"></div>
								</div>
							</div>
						</div>
					</div>
					<div class="pswp__share-modal pswp__share-modal--hidden pswp__single-tap">
						<div class="pswp__share-tooltip"></div>
					</div>
					<button class="pswp__button pswp__button--arrow--left" title="Previous (arrow left)" aria-label="Previous (arrow left)"></button>
					<button class="pswp__button pswp__button--arrow--right" title="Next (arrow right)" aria-label="Next (arrow right)"></button>
					<div class="pswp__caption">
						<div class="pswp__caption__center"></div>
					</div>
				</div>
			</div>
		</div>

		<!-- Core javascripts -->
		<!-- jQuery must load first: vendor_bundle.min.js is a chain of jQuery-plugin
		     IIFEs invoked as `}(jQuery)` at parse time - if jQuery isn't defined yet,
		     each of those throws immediately and none of its setup code (including
		     the Swiper/Fancybox glue) ever runs. Swiper's own core library also has
		     to load before core.min.js/vendor_bundle.min.js reference window.Swiper. -->
		<script src="/assets/js/vendor.jquery.min.js"></script>
		<script src="/assets/js/vendor.swiper.js"></script>
		<script src="/assets/js/core.min.js"></script>
		<script src="/assets/js/vendor_bundle.min.js"></script>
		<!-- Main navigation: keyboard + touch dropdowns, responsive class swap -->
		<script src="/js/nav.js" defer></script>
		<!-- Fancybox (image galleries) -->
		<script src="/assets/js/vendor.fancybox.js"></script>
		<!-- PhotoSwipe (Photo Swiper widget) -->
		<script src="/assets/js/vendor.photoswipe.js"></script>
		<script src="/assets/js/vendor.photoswipe-ui-default.js"></script>
		<!-- Your custom javascripts -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/lazysizes/5.3.2/plugins/respimg/ls.respimg.min.js" integrity="sha512-wx6mQs3FAg3I/qwFLpdbFrUbI3bR5OjPFCg8MlszSokKIlh9Knwsj0TG3VzEOke2JDXpDfcvOdc7mACgRbnyow==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/lazysizes/5.3.2/plugins/bgset/ls.bgset.min.js" integrity="sha512-H0f3dM0T89f58GnoRxtsltBJ2LB37QllwC/Gok/xTAxBskX/8kaqjQ1bt1A1UuvtsPdz+SteSO4tVlJ39ybC+g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/lazysizes/5.3.2/lazysizes.min.js" integrity="sha512-q583ppKrCRc7N5O0n2nzUiJ+suUv7Et1JGels4bXOaMFQcamPk9HjdUknZuuFjBNs7tsMuadge5k9RzdmO+1GQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
		@* <script src="/scripts/counter.js"></script>
		<script src="/scripts/SocialMedia.js"></script>
		<script async src="//www.instagram.com/embed.js"></script> *@
		@* <script>
			function translatePage(lang) {
				var url = window.location.href;
				window.location = `https://translate.google.com/translate?hl=${lang}&sl=auto&u=${encodeURIComponent(url)}`;
			}
		</script> *@
			<!-- AOS JS -->
		@* <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
		<script>
			AOS.init();
		</script>
		<script type="module"
        	src="/App_Plugins/UmbracoCommunityAIChatbot/widget.js"
        	data-instance="internal-chatbot">
		</script> *@
		@* <script>(function(d, s, id) {var js, fjs = d.getElementsByTagName(s)[0];window.key='WY6B1Z8LT@PR9K3TLT';window.url='//www.k12insight.com/';if (d.getElementById(id))return;js = d.createElement(s);js.id = id;js.src = "//www.k12insight.com/Lets-Talk/LtTabJs.aspx";fjs.parentNode.insertBefore(js, fjs);}(document, 'script', 'Lets-Talk'));</script> *@
	</body>
</html>