@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Routing
@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Extensions
@using UmbracoBase.Core.Constants

@inject IPublishedUrlProvider PublishedUrlProvider
@{
    // Breadcrumb trail: every ancestor except the Site root, shallow to deep.
    var selection = Model.Ancestors()
        .Where(x => x?.ContentType?.Alias != Site.ModelTypeAlias)
        .OrderBy(x => x.Level)
        .ToArray();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb justify-content-md-end justify-content-center">
        @foreach (IPublishedContent item in selection)
        {
            if (!item.IsVisible())
            {
                <li class="breadcrumb-item"><a href="@item.Url(PublishedUrlProvider)">@(string.IsNullOrWhiteSpace(item.Value<string>(PropertyAlias.PageTitle)) ? item.Name : item.Value<string>(PropertyAlias.PageTitle))</a></li>
            }
        }
        <li class="breadcrumb-item active" aria-current="page">@(string.IsNullOrEmpty(Model.Value<string>(PropertyAlias.PageTitle)) ? Model.Name : Model.Value<string>(PropertyAlias.PageTitle))</li>
    </ol>
</nav>
