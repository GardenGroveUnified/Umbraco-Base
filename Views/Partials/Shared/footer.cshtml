}

<footer id="footer" class="santiago-footer">
    <div class="container-fluid">
        <div class="row">

            <!-- LEFT SIDE -->
            <div class="col-12 col-lg-5 footer-left">
                <h2 class="footer-brand">Santiago<span class="footer-brand-second">High School</span></h2>

                <div class="footer-contact">
                    <a href="https://maps.google.com/?q=12342+Trask+Ave.,+Garden+Grove,+CA+92843"
                       target="_blank"
                       rel="noopener">
                        12342 Trask Ave., Garden Grove, CA 92843
                    </a>

                    <div class="footer-phone">
                        Phone:
                        <a href="tel:+17146636215">(714) 663-6215</a>
                        <span class="footer-divider">|</span>
                        Fax: (714) 663-6290
                    </div>
                </div>
