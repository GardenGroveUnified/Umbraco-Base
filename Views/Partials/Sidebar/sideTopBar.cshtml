@inherits UmbracoViewPage<BlockListItem>

@using Umbraco.Cms.Core.Models;
@using Umbraco.Cms.Core.Models.Blocks;
@using Umbraco.Cms.Core.Models.PublishedContent;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content  = (ContentModels.SideTopBar)Model.Content;
    var settings = (ContentModels.SideTopBarSettings)Model.Settings;

    if (settings?.BlockVisibility == false) { return; }

    var currentPage = Umbraco.AssignedContentItem;
    var currentUrl  = currentPage?.Url() ?? Context.Request.Path.Value ?? string.Empty;

    // --- Settings-driven classes ---
    var pillsClass      = settings?.DisplayAsPills == true ? "nav-pills" : "";
    var verticalSpacing = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? "py-3" : settings.VerticalSpacing;
    var alignClass      = settings?.HorizontalAlignment switch
    {
        "center" => "text-center",
        "right"  => "text-end",
        _        => "text-start"
    };
    var extraClasses = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;
    var anchorId = settings?.AnchorId;

    // --- Build auto-nav items from the content tree based on displayOptions ---
    var displayOption = content?.DisplayOptions ?? "none";

    IEnumerable<IPublishedContent> autoNavItems = Enumerable.Empty<IPublishedContent>();
    IPublishedContent parentNavItem = null;

    if (currentPage != null && displayOption != "none")
    {
        switch (displayOption)
        {
            case "siblings":
                autoNavItems = currentPage.Parent?.Children ?? Enumerable.Empty<IPublishedContent>();
                break;

            case "children":
                autoNavItems = currentPage.Children ?? Enumerable.Empty<IPublishedContent>();
                break;

            case "sibsChildren":
                var siblings = currentPage.Parent?.Children ?? Enumerable.Empty<IPublishedContent>();
                var children = currentPage.Children ?? Enumerable.Empty<IPublishedContent>();
                autoNavItems = siblings.Concat(children);
                break;

            case "parentSibs":
                if (currentPage.Parent != null)
                {
                    parentNavItem = currentPage.Parent;
                    autoNavItems  = currentPage.Parent.Parent?.Children ?? Enumerable.Empty<IPublishedContent>();
                }
                break;
        }
    }

    // Helper: is the given URL the active page?
    bool IsActive(string url) =>
        !string.IsNullOrWhiteSpace(url) &&
        currentUrl.TrimEnd('/').Equals(url.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
}

<div class="sidebar-nav @verticalSpacing @extraClasses"
     @if (!string.IsNullOrWhiteSpace(anchorId)) { <text>id="@anchorId"</text> }>

    @* ---- Optional heading ---- *@
    @if (!string.IsNullOrWhiteSpace(content?.Heading))
    {
        <p class="sidebar-nav__heading fw-semibold text-uppercase small mb-2 @alignClass">
            @content.Heading
        </p>
    }

    <nav aria-label="@(content?.Heading ?? "Section navigation")">
        <ul class="nav flex-column @pillsClass gap-1">

            @* ---- SelfNameLink: the manually defined top entry ---- *@
            @if (content?.SelfNameLink != null)
            {
                var selfUrl    = content.SelfNameLink.Url ?? "#";
                var selfName   = string.IsNullOrWhiteSpace(content.SelfNameLink.Name) ? selfUrl : content.SelfNameLink.Name;
                var selfTarget = content.SelfNameLink.Target ?? "_self";

                <li class="nav-item">
                    <a class="nav-link sidebar-nav__self fw-medium @alignClass @(IsActive(selfUrl) ? "active" : "")"
                       href="@selfUrl"
                       target="@selfTarget"
                       @if (IsActive(selfUrl)) { <text>aria-current="page"</text> }>
                        @selfName
                    </a>
                </li>
            }

            @* ---- parentSibs: show the parent as a distinct entry before its siblings ---- *@
            @if (parentNavItem != null)
            {
                var pUrl = parentNavItem.Url();
                <li class="nav-item">
                    <a class="nav-link sidebar-nav__parent fw-medium @alignClass @(IsActive(pUrl) ? "active" : "")"
                       href="@pUrl"
                       @if (IsActive(pUrl)) { <text>aria-current="page"</text> }>
                        @parentNavItem.Name
                    </a>
                </li>
            }

            @* ---- Auto-generated links from the content tree ---- *@
            @foreach (var page in autoNavItems)
            {
                var pageUrl  = page.Url();
                var isActive = IsActive(pageUrl);
                var isCurrent = page.Id == currentPage?.Id;

                <li class="nav-item">
                    <a class="nav-link sidebar-nav__auto-link @alignClass @(isActive || isCurrent ? "active" : "")"
                       href="@pageUrl"
                       @if (isActive || isCurrent) { <text>aria-current="page"</text> }>
                        @page.Name
                    </a>

                    @* sibsChildren: indent children under the current page entry ---- *@
                    @if (displayOption == "sibsChildren" && isCurrent && page.Children.Any())
                    {
                        <ul class="nav flex-column @pillsClass ms-3 mt-1">
                            @foreach (var child in page.Children)
                            {
                                var childUrl    = child.Url();
                                var childActive = IsActive(childUrl);
                                <li class="nav-item">
                                    <a class="nav-link sidebar-nav__child-link @alignClass @(childActive ? "active" : "")"
                                       href="@childUrl"
                                       @if (childActive) { <text>aria-current="page"</text> }>
                                        @child.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }

            @* ---- AdditionalSubLinks: manually added extra links, always appended ---- *@
            @if (content?.AdditionalSubLinks != null)
            {
                foreach (var link in content.AdditionalSubLinks.Where(l => l != null))
                {
                    var linkUrl    = link.Url ?? "#";
                    var linkName   = string.IsNullOrWhiteSpace(link.Name) ? linkUrl : link.Name;
                    var linkTarget = link.Target ?? "_self";

                    <li class="nav-item">
                        <a class="nav-link sidebar-nav__sub-link @alignClass @(IsActive(linkUrl) ? "active" : "")"
                           href="@linkUrl"
                           target="@linkTarget"
                           @if (IsActive(linkUrl)) { <text>aria-current="page"</text> }>
                            @linkName
                        </a>
                    </li>
                }
            }

        </ul>
    </nav>

</div>
