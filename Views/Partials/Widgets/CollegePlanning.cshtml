@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@{
    var content = (ContentModels.CollegePlanning)Model.Content;
    var settings = (ContentModels.CollegePlanningSettings?)Model.Settings;
    if (settings?.BlockVisibility == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;

    var containerWidthClass = settings?.ContainerWidth switch
    {
        "small" => "container-md container-small",
        "standard" => "container",
        "big" => "container-xlg",
        "full width" => "container-fluid",
        _ => "container"
    };
    var backgroundColorClass = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "bg-transparent" : settings?.BackgroundColor;
    var verticalSpacingClass = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? "py-3" : settings.VerticalSpacing;
    var topBorderClass = settings?.ShowTopBorder == true ? "border-top" : "";
    var classNames = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;

    var milestones = content?.Milestones?
        .Select(item => (ContentModels.CollegePlanningMilestone)item.Content)
        .Where(m => m?.BlockVisibility != false)
        .ToList() ?? new List<ContentModels.CollegePlanningMilestone>();

    var hasActionLink = content?.ActionLink != null && !string.IsNullOrEmpty(content.ActionLink.Url);
}

@if (milestones.Any())
{
    <section class="section block-college-planning @backgroundColorClass @verticalSpacingClass @topBorderClass @classNames"
    @if (!string.IsNullOrEmpty(settings?.AnchorId))
    {
        <text>id="@settings.AnchorId"</text>
    }>
        <div class="@containerWidthClass">
            @if (!string.IsNullOrEmpty(content?.Preheading) || !string.IsNullOrEmpty(content?.Heading) || hasActionLink)
            {
                <div class="home-section-title">
                    <div class="home-section-title__label">
                        <span class="home-section-title__bar"></span>
                        @if (!string.IsNullOrEmpty(content?.Heading) && order == 0)
                        {
                            <h1 class="head display-6 bold mb-0">@content.Heading</h1>
                        }
                        else if (!string.IsNullOrEmpty(content?.Heading))
                        {
                            <h2 class="head display-6 bold mb-0">@content.Heading</h2>
                        }
                        else if (!string.IsNullOrEmpty(content?.Preheading))
                        {
                            @content.Preheading
                        }
                    </div>
                    @if (hasActionLink)
                    {
                        <a href="@content!.ActionLink!.Url" target="@(content.ActionLink.Target ?? "_self")" class="home-section-title__action">@(string.IsNullOrEmpty(content.ActionLink.Name) ? "Learn more" : content.ActionLink.Name) &rarr;</a>
                    }
                </div>
                @if (!string.IsNullOrEmpty(content?.Text?.ToString()))
                {
                    <p>@content.Text</p>
                }
            }

            @for (var i = 0; i < milestones.Count; i++)
            {
                var milestone = milestones[i];
                var isCurrent = milestone.Current;

                <div class="d-flex gap-3 mb-3 align-items-start">
                    <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center"
                         style="width:40px; height:40px; font-size:0.75rem; font-weight:700;
                                background:@(isCurrent ? "var(--shs-purple,#4a1f7a)" : "var(--shs-purple-pale,#f3edfa)");
                                color:@(isCurrent ? "#fff" : "var(--shs-purple,#4a1f7a)");">
                        @milestone.Grade
                    </div>
                    <div class="flex-grow-1">
                        @if (milestone.Items != null)
                        {
                            @foreach (var checklistItem in milestone.Items.Where(x => !string.IsNullOrWhiteSpace(x)))
                            {
                                <div class="d-flex align-items-center gap-2 mb-1" style="font-size:0.85rem; color:#333;">
                                    <span class="flex-shrink-0 rounded-circle" style="width:5px; height:5px; background:var(--shs-gold,#c9a227);"></span>
                                    <span>@checklistItem</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}
