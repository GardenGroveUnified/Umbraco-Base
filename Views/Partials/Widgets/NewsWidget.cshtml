@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@{
    var content = (ContentModels.NewsWidget)Model.Content;
    var settings = (ContentModels.NewsWidgetSettings?)Model.Settings;
    if (settings?.BlockVisibility == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;
    var verticalSpacingClass = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? "py-4" : settings.VerticalSpacing;
    var classNames = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;

    var newsItems = content?.NewsList?
        .Select(item => (ContentModels.NewsItem)item.Content)
        .Where(n => n?.BlockVisibility != false)
        .ToList() ?? new List<ContentModels.NewsItem>();

    var hasActionLink = content?.ActionLink != null && !string.IsNullOrEmpty(content.ActionLink.Url);
}

@if (newsItems.Any())
{
    <section class="section block-recent-news @verticalSpacingClass @classNames"
    @if (!string.IsNullOrEmpty(settings?.AnchorId))
    {
        <text>id="@settings.AnchorId"</text>
    }>
        <div class="container-fluid px-4">
            @if (!string.IsNullOrEmpty(content?.Preheading) || !string.IsNullOrEmpty(content?.Heading) || hasActionLink)
            {
                <div class="news-widget__header">
                    <div class="news-widget__label">
                        @if (!string.IsNullOrEmpty(content?.Preheading))
                        {
                            <span>@content.Preheading</span>
                        }
                        @if (!string.IsNullOrEmpty(content?.Heading) && order == 0)
                        {
                            <h1 class="news-widget__heading">@content.Heading</h1>
                        }
                        else if (!string.IsNullOrEmpty(content?.Heading))
                        {
                            <h2 class="news-widget__heading">@content.Heading</h2>
                        }
                    </div>
                    @if (hasActionLink)
                    {
                        <a href="@content!.ActionLink!.Url" target="@(content.ActionLink.Target ?? "_self")" class="news-widget__action">@(string.IsNullOrEmpty(content.ActionLink.Name) ? "All news" : content.ActionLink.Name) &rarr;</a>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(content?.Text?.ToString()))
            {
                <p class="news-widget__text">@content.Text</p>
            }

            @foreach (var news in newsItems)
            {
                var photoUrl = news?.Photo?.GetCropUrl(160, 130);
                var hasLink = news?.Link != null && !string.IsNullOrEmpty(news.Link.Url);
                var dateText = news?.Date != null && news.Date > DateTime.MinValue ? news.Date.ToString("MMM d, yyyy") : null;

                <div class="news-item">
                    @if (!string.IsNullOrEmpty(photoUrl))
                    {
                        <div class="news-item__thumb"><img src="@photoUrl" alt="@news?.Title" /></div>
                    }
                    else
                    {
                        <div class="news-item__thumb news-item__thumb--empty"></div>
                    }
                    <div class="news-item__body">
                        @if (!string.IsNullOrEmpty(news?.Tag))
                        {
                            <span class="news-item__tag">@news.Tag</span>
                        }
                        <div class="news-item__title">
                            @if (hasLink)
                            {
                                <a href="@news!.Link!.Url" target="@(news.Link.Target ?? "_self")">@news.Title</a>
                            }
                            else
                            {
                                @news?.Title
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(dateText))
                        {
                            <div class="news-item__date">@dateText</div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}
