@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@{
    var content = (ContentModels.QuickLinksBar)Model.Content;
    var settings = (ContentModels.QuickLinksBarSettings?)Model.Settings;
    if (settings?.BlockVisibility == false) { return; }

    var links = content?.Links?
        .Select(item => (ContentModels.QuickLinkItem)item.Content)
        .Where(li => li?.BlockVisibility != false)
        .ToList() ?? new List<ContentModels.QuickLinkItem>();

    var classNames = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;
}

@if (links.Any())
{
    <div class="home-quicklinks @classNames"
    @if (!string.IsNullOrEmpty(settings?.AnchorId))
    {
        <text>id="@settings.AnchorId"</text>
    }>
        <div class="container-fluid">
            <div class="home-quicklinks__grid">
                @foreach (var link in links)
                {
                    var url = link?.Link?.Url;
                    // A quick link with no URL is a content mistake; skip it rather
                    // than render a dead href="#" that jumps to the top of the page.
                    if (string.IsNullOrEmpty(url)) { continue; }

                    var target = link?.Link?.Target ?? "_self";
                    var label = link?.Label;
                    // When the label is empty only the icon shows, so the link needs
                    // an accessible name from somewhere.
                    var accessibleName = !string.IsNullOrWhiteSpace(label) ? label : link?.Link?.Name;

                    <a href="@url" target="@target" class="home-quicklinks__item"
                    @if (target != "_self")
                    {
                        <text>rel="noopener"</text>
                    }
                    @if (string.IsNullOrWhiteSpace(label) && !string.IsNullOrWhiteSpace(accessibleName))
                    {
                        <text>aria-label="@accessibleName"</text>
                    }>
                        <span class="home-quicklinks__icon">
                            @if (!string.IsNullOrEmpty(link?.Icon))
                            {
                                <i class="@link.Icon" aria-hidden="true"></i>
                            }
                        </span>
                        <span class="home-quicklinks__label">@label</span>
                    </a>
                }
            </div>
        </div>
    </div>
}
