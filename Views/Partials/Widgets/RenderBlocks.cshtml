@using Umbraco.Cms.Core.Models;
@using Microsoft.AspNetCore.Html;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Blocks;
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = null;

    // Accept an explicit block collection from ViewData, or fall back to Model's "Widgets"
    var blocks = (ViewData.ContainsKey("Blocks")
        ? ViewData["Blocks"] as IEnumerable<BlockListItem>
        : Model.Value<IEnumerable<BlockListItem>>("Widgets"))?.ToList();

    var startIndex = ViewData.ContainsKey("StartIndex") ? (int)(ViewData["StartIndex"] ?? 0) : 0;
    var parentPage = ViewData.ContainsKey("ParentPage") ? ViewData["ParentPage"] : null;
}

@if (blocks != null && blocks.Any())
{
    int index = startIndex;
    for (var i = 0; i < blocks.Count; i++)
    {
        var block = blocks[i];
        var content = block.Content;
        var blockViewData = new ViewDataDictionary(ViewData);
        blockViewData["Order"] = index;
        blockViewData["ParentPage"] = parentPage;

        // Upcoming Events (Home style) immediately followed by Recent News
        // is a special-cased pairing: wrap both in a flex row so they sit
        // side-by-side with matching heights, instead of two independent
        // full-width sections. See .widget-pair-row in Events.css.
        var isHomeStyleEvents = content.ContentType.Alias == "eventsWidget"
            && block.Settings?.Value<string>("blockStyle") == "Style 2";
        var nextIsNews = i + 1 < blocks.Count && blocks[i + 1].Content.ContentType.Alias is "newsWidget" or "newsFeed";

        if (isHomeStyleEvents && nextIsNews)
        {
            var newsBlock = blocks[i + 1];
            var newsViewData = new ViewDataDictionary(ViewData);
            newsViewData["Order"] = index + 1;
            newsViewData["ParentPage"] = parentPage;

            <div class="widget-pair-row">
                @await Html.PartialAsync("Widgets/" + content.ContentType.Alias, block, blockViewData)
                @await Html.PartialAsync("Widgets/" + newsBlock.Content.ContentType.Alias, newsBlock, newsViewData)
            </div>
            index += 2;
            i++;
            continue;
        }

        @await Html.PartialAsync("Widgets/" + content.ContentType.Alias, block, blockViewData);
        index++;
    }
}