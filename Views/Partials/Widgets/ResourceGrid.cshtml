@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@{
    var content = (ContentModels.ResourceGrid)Model.Content;
    var settings = (ContentModels.ResourceGridSettings?)Model.Settings;
    if (settings?.BlockVisibility == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;

    var containerWidthClass = settings?.ContainerWidth switch
    {
        "small" => "container-md container-small",
        "standard" => "container",
        "big" => "container-xlg",
        "full width" => "container-fluid",
        _ => "container"
    };
    var backgroundColorClass = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "bg-transparent" : settings?.BackgroundColor;
    var verticalSpacingClass = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? "py-3" : settings.VerticalSpacing;
    var topBorderClass = settings?.ShowTopBorder == true ? "border-top" : "";
    var classNames = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;

    var gutterSpacingClass = string.IsNullOrEmpty(settings?.ColumnSpacing) ? "gutters-sm" : settings.ColumnSpacing;
    var justifyContentClass = settings?.HorizontalAlignment switch
    {
        "left" => "justify-content-start",
        "right" => "justify-content-end",
        _ => "justify-content-center"
    };

    var columnMap = new Dictionary<string, string>
    {
        ["max"] = "col-12 col-sm-6 col-md-4 col-lg-3 col-xxxl",
        ["6"] = "col-12 col-sm-6 col-md-2 col-lg-2",
        ["5"] = "col-12 col-sm-6 col-md-4 col-lg-5th",
        ["4"] = "col-12 col-sm-6 col-lg-4 col-xl-3",
        ["3"] = "col-12 col-sm-6 col-md-4 col-lg-4",
        ["2"] = "col-6 col-md-6 col-lg-6",
        ["1"] = "col-12 col-md-12 col-lg-12",
    };
    var itemsPerRowKey = settings?.ItemsPerRow > 0 ? settings.ItemsPerRow.ToString("0") : "2";
    var numberOfColumnClass = columnMap.GetValueOrDefault(itemsPerRowKey, "col-6 col-md-6");

    var resources = content?.ResourceList?
        .Select(item => (ContentModels.ResourceItem)item.Content)
        .Where(r => r?.BlockVisibility != false)
        .ToList() ?? new List<ContentModels.ResourceItem>();

    var hasActionLink = content?.ActionLink != null && !string.IsNullOrEmpty(content.ActionLink.Url);
}

@if (resources.Any())
{
    <section class="section block-resource-grid @backgroundColorClass @verticalSpacingClass @topBorderClass @classNames"
    @if (!string.IsNullOrEmpty(settings?.AnchorId))
    {
        <text>id="@settings.AnchorId"</text>
    }>
        <div class="@containerWidthClass">
            @if (!string.IsNullOrEmpty(content?.Preheading) || !string.IsNullOrEmpty(content?.Heading) || hasActionLink)
            {
                <div class="home-section-title">
                    <div class="home-section-title__label">
                        <span class="home-section-title__bar"></span>
                        @if (!string.IsNullOrEmpty(content?.Heading) && order == 0)
                        {
                            <h1 class="head display-6 bold mb-0">@content.Heading</h1>
                        }
                        else if (!string.IsNullOrEmpty(content?.Heading))
                        {
                            <h2 class="head display-6 bold mb-0">@content.Heading</h2>
                        }
                        else if (!string.IsNullOrEmpty(content?.Preheading))
                        {
                            @content.Preheading
                        }
                    </div>
                    @if (hasActionLink)
                    {
                        <a href="@content!.ActionLink!.Url" target="@(content.ActionLink.Target ?? "_self")" class="home-section-title__action">@(string.IsNullOrEmpty(content.ActionLink.Name) ? "View all" : content.ActionLink.Name) &rarr;</a>
                    }
                </div>
                @if (!string.IsNullOrEmpty(content?.Text?.ToString()))
                {
                    <p>@content.Text</p>
                }
            }

            <div class="row @gutterSpacingClass @justifyContentClass">
                @foreach (var resource in resources)
                {
                    var hasLink = resource?.Link != null && !string.IsNullOrEmpty(resource.Link.Url);

                    <div class="@numberOfColumnClass mb-2">
                        @if (hasLink)
                        {
                            <a href="@resource!.Link!.Url" target="@(resource.Link.Target ?? "_self")"
                               class="d-flex align-items-center gap-2 rounded bg-white p-2 text-decoration-none h-100"
                               style="border:1px solid #eee; font-size:0.85rem; color:#333;">
                                <span class="flex-shrink-0 rounded" style="width:8px; height:8px; background:var(--shs-gold,#c9a227);"></span>
                                <span>@resource.Label</span>
                            </a>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 rounded bg-white p-2 h-100"
                                 style="border:1px solid #eee; font-size:0.85rem; color:#333;">
                                <span class="flex-shrink-0 rounded" style="width:8px; height:8px; background:var(--shs-gold,#c9a227);"></span>
                                <span>@resource?.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}
