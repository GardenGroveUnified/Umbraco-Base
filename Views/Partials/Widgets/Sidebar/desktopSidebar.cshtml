@inherits UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent;
@using Umbraco.Cms.Core.Models;
@using Umbraco.Cms.Core.Models.Blocks;
@{
	// Use this page's own Sidebar Blocks; if it has none, inherit the nearest
	// ancestor's - so a section sidebar configured once (e.g. on JROTC) cascades
	// to every descendant page. The sideTopBar widget still resolves
	// siblings/children relative to the *current* page.
	var sidebarSource = Model.AncestorsOrSelf()
		.FirstOrDefault(p => p.Value<IEnumerable<BlockListItem>>("sidebarBlocks")?.Any() == true);
	var sidebarBlocks = sidebarSource?.Value<IEnumerable<BlockListItem>>("sidebarBlocks");
	ViewData["IsSidebarInSidebarBlocks"] = true;
}

@if (sidebarBlocks != null && sidebarBlocks.Any())
{
	@foreach (BlockListItem block in sidebarBlocks)
	{
		var blockType = block.Content.ContentType.Alias;
		var blockViewData = new ViewDataDictionary(ViewData) { ["SidebarOwner"] = sidebarSource };
		@await Html.PartialAsync("~/Views/Partials/Widgets/Sidebar/" + blockType + ".cshtml", block, blockViewData)
	}
}