@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@{
	var content = (ContentModels.Slider)Model.Content;
	var settings = (ContentModels.SliderSettings?)Model.Settings;
	if (settings?.BlockVisibility == false) { return; }
	if (content.SliderItems == null || !content.SliderItems.Any()) return;
	int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;

	//Block Appearance
	bool showArrow = true;
	var delay = settings?.SliderTiming == 0 ? 10000 : settings?.SliderTiming * 1000;
	// Swiper's loop mode requires more than one real slide - with only one,
	// it fails to initialize and the swiper-preloader spinner never clears.
	var loopEnabled = content.SliderItems.Count() > 1;
	var autoplayEnabled = settings?.DisableAutoplay != true;
	var autoplayJson = autoplayEnabled ? $"{{ \"delay\": {delay}, \"disableOnInteraction\": false }}" : "false";

	var containerWidthClass = "container";
	switch (settings?.ContainerWidth)
	{
		case "small":
			containerWidthClass = "container-md container-small";
			break;
		case "standard":
			containerWidthClass = "container";
			break;
		case "big":
			containerWidthClass = "container-xlg";
			break;
		case "full width":
			containerWidthClass = "container-fluid";
			break;
	}
	// The dedicated "Full-Width Banner" toggle is the intuitive, front-and-center
	// way to get an edge-to-edge hero; it overrides the generic Container Width
	// setting (still available for anyone who wants small/standard/big instead).
	if (settings?.FullWidthBanner == true)
	{
		containerWidthClass = "container-fluid";
	}
	var backgroundColorClass = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "bg-white" : "";
	var backgroundColorStyle = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "" : $"background-color:{settings.BackgroundColor};";
	var verticalSpacingClass = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? "py-3" : settings.VerticalSpacing;
	var topBorderClass = settings?.ShowTopBorder == true ? "border-top" : "";
	var headerCenterTextClass = settings?.CenterHeading == true ? "text-center" : string.Empty;

	if (content.SliderItems.Any())
	{
		<section class="section block-slider @(backgroundColorClass) @(verticalSpacingClass) @(topBorderClass)" style="@backgroundColorStyle" @if (!string.IsNullOrEmpty(settings?.AnchorId))
		{
			<text>id="@settings.AnchorId"</text>
		}>
			<div class="@(containerWidthClass)">
				@if (order == 0)
				{
					<h1 class="d-none">@settings?.AnchorId</h1>
				}
				else if (order != 0)
				{
					<h2 class="d-none">@settings?.AnchorId</h2>
				}
				<div class="swiper-container swiper-btn-group swiper-btn-group-end text-white p-0 vh-75 overflow-hidden swiper-preloader"
						data-swiper='{
								"slidesPerView": 1,
								"spaceBetween": 0,
								"autoplay": @autoplayJson,
								"loop": @loopEnabled.ToString().ToLowerInvariant(),
								"pagination": { "type": "bullets" }
							}'>
					<div class="swiper-wrapper h-100">
						@foreach (var sliderItem in content.SliderItems)
						{
							var item = (SliderItem)sliderItem.Content;
							if (item.BlockVisibility != true) continue;
                            var styling = "";
                            @if (item?.Preheading != "" || item.Heading != "" || item?.SliderText?.ToString() != ""){styling = "hero-slide__panel p-3";}
							var itemImage = item?.Image != null ? item.Image.Url() : "";

							<!-- slide -->
							<div class="h-100 swiper-slide d-middle align-items-end bg-white overlay-dark overlay-opacity-1 d-middle bg-cover" style="background-image:url('@itemImage')">
								<div class="container z-index-10 text-white text-center-xs @styling">
									<div class="row">
										<div class="col">
											<div class="@(headerCenterTextClass) hero-slide">
												@if (item?.Preheading != "" || item.Heading != "" || item?.SliderText?.ToString() != "")
												{
													<div class="block__headerx mb-3">
														@if (item?.Preheading != "")
														{
															<div class="hero-slide__label">
																<span class="hero-slide__label-bar"></span>
																<span>@item?.Preheading</span>
															</div>
														}
														@if (item?.Heading != "")
														{
															<h2 class="hero-slide__heading" data-swiper-parallax="-300">@item?.Heading</h2>
														}
													</div>

													@if (item?.SliderText?.ToString() != "")
													{
														<p class="hero-slide__text" data-swiper-parallax="-100">@item?.SliderText</p>
													}
												}
												@if (item?.SliderLinksButtons != null && item.SliderLinksButtons.Any())
												{
													<div class="hero-slide__actions">
														@{ var linkIndex = 0; }
														@foreach (var link in item.SliderLinksButtons)
														{
															<a href="@link.Url" target="@(link.Target)" class="hero-slide__btn @(linkIndex == 0 ? "hero-slide__btn--primary" : "hero-slide__btn--secondary")"
															@if (link.Target == "_blank")
															{
																<text>rel="noopener"</text>
															}>@link.Name</a>
															linkIndex++;
														}
													</div>
												}
											</div>
										</div>
									</div>
								</div>
							</div>
							<!-- /slide -->
						}
					</div>
					@if (showArrow)
					{
						<!-- Add Arrows -->
						<div class="swiper-button-next swiper-button-white"></div>
						<div class="swiper-button-prev swiper-button-white"></div>
					}
				</div>
			</div>
		</section>
	}

}


