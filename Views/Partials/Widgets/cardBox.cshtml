@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@{
    // Model-agnostic access so the view compiles before ModelsBuilder regenerates.
    var content = Model.Content;
    var settings = Model.Settings;

    // Convention in this codebase: blockVisibility toggle is "visible" (default on);
    // only an explicit false hides the block.
    if (settings?.Value<bool?>("blockVisibility") == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;

    var heading    = content.Value<string>("heading");
    var preheading = content.Value<string>("preheading");
    var text       = content.Value<IHtmlEncodedString>("text");
    var cards      = content.Value<IEnumerable<BlockListItem>>("cards");

    var anchorId       = settings?.Value<string>("anchorId");
    var bgColor        = settings?.Value<string>("backgroundColor");
    var verticalSpace  = settings?.Value<string>("verticalSpacing");
    var showTopBorder  = settings?.Value<bool>("showTopBorder") == true;
    var centerHeading  = settings?.Value<bool>("centerHeading") == true;

    var containerWidthClass = settings?.Value<string>("containerWidth") switch
    {
        "small"      => "container-md container-small",
        "standard"   => "container",
        "big"        => "container-xlg w-md-75",
        "full width" => "container-fluid",
        _            => "container"
    };
    var verticalSpacingClass = string.IsNullOrWhiteSpace(verticalSpace) ? "py-3" : verticalSpace;
    var topBorderClass       = showTopBorder ? "border-top" : "";
    var backgroundColorClass = string.IsNullOrWhiteSpace(bgColor) ? "bg-transparent" : "";
    var backgroundColorStyle = string.IsNullOrWhiteSpace(bgColor) ? "" : $"background-color:{bgColor};";
    var headerCenterTextClass = centerHeading ? "text-center" : "text-left";

    var gutterSpacingClass = settings?.Value<string>("columnSpacing") is { Length: > 0 } cs ? cs : "gutters-md";
    var justifyContentClass = settings?.Value<string>("horizontalAlignment") switch
    {
        "left"  => "justify-content-start",
        "right" => "justify-content-end",
        _       => "justify-content-center"
    };

    var columnMap = new Dictionary<string, string>
    {
        ["6"] = "col-6 col-md-4 col-lg-2",
        ["5"] = "col-6 col-md-4 col-lg-5th",
        ["4"] = "col-12 col-sm-6 col-lg-3",
        ["3"] = "col-12 col-sm-6 col-lg-4",
        ["2"] = "col-12 col-md-6",
        ["1"] = "col-12",
    };
    var itemsPerRow = settings?.Value<decimal>("itemsPerRow") ?? 0m;
    var columnClass = columnMap.GetValueOrDefault(itemsPerRow > 0 ? itemsPerRow.ToString("0") : "3", "col-12 col-sm-6 col-lg-4");
}

@if (cards != null && cards.Any())
{
    <section class="section block-card-box @backgroundColorClass @verticalSpacingClass @topBorderClass" style="@backgroundColorStyle"
    @if (!string.IsNullOrEmpty(anchorId))
    {
        <text>id="@anchorId"</text>
    }>
        <div class="@containerWidthClass">
            @if (!string.IsNullOrEmpty(preheading) || !string.IsNullOrEmpty(heading) || !string.IsNullOrEmpty(text?.ToString()))
            {
                <div class="@headerCenterTextClass mb-4">
                    @if (!string.IsNullOrEmpty(preheading))
                    {
                        <div class="pre-head">@preheading</div>
                    }
                    @if (!string.IsNullOrEmpty(heading))
                    {
                        @if (order == 0)
                        {
                            <h1 class="head display-5 bold">@heading</h1>
                        }
                        else
                        {
                            <h2 class="head display-6 bold">@heading</h2>
                        }
                    }
                    @if (!string.IsNullOrEmpty(text?.ToString()))
                    {
                        <div>@text</div>
                    }
                </div>
            }

            <div class="row @gutterSpacingClass @justifyContentClass">
                @foreach (var item in cards)
                {
                    var card = item.Content;
                    if (card.Value<bool?>("blockVisibility") == false) { continue; }

                    var icon  = card.Value<string>("icon");
                    var title = card.Value<string>("title");
                    var body  = card.Value<IHtmlEncodedString>("text");
                    var link  = card.Value<Link>("link");
                    var hasLink = !string.IsNullOrEmpty(link?.Url);

                    <div class="@columnClass mb-4">
                        <div class="card-box__item h-100">
                            @if (hasLink)
                            {
                                <a href="@link!.Url" target="@(link.Target ?? "_self")" class="stretched-link" aria-label="@title"></a>
                            }
                            @if (!string.IsNullOrEmpty(icon))
                            {
                                <span class="card-box__icon"><i class="@icon" aria-hidden="true"></i></span>
                            }
                            @if (!string.IsNullOrEmpty(title))
                            {
                                <h3 class="card-box__title">@title</h3>
                            }
                            @if (!string.IsNullOrEmpty(body?.ToString()))
                            {
                                <div class="card-box__text">@body</div>
                            }
                            @if (hasLink)
                            {
                                <span class="card-box__more" aria-hidden="true">@(string.IsNullOrWhiteSpace(link!.Name) ? "Learn more" : link.Name) &rarr;</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
