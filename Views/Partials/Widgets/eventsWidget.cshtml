@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@{
    var content = (ContentModels.EventsWidget)Model.Content;
    var settings = (ContentModels.EventsWidgetSettings?)Model.Settings;
    if (settings?.BlockVisibility == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;

    var containerWidthClass = settings?.ContainerWidth switch
    {
        "small" => "container-md container-small",
        "standard" => "container",
        "big" => "container-xlg",
        "full width" => "container-fluid",
        _ => "container"
    };
    var backgroundColorClass = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "bg-transparent" : settings?.BackgroundColor;
    var verticalSpacingClass = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? "py-3" : settings.VerticalSpacing;
    var topBorderClass = settings?.ShowTopBorder == true ? "border-top" : "";
    var headerCenterTextClass = settings?.CenterHeading == true ? "text-center" : "text-left";
    var classNames = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;

    // Only show events that are today or in the future, always sorted chronologically
    // regardless of the order they were entered in - editors don't have to keep the
    // list manually re-sorted.
    var events = content?.EventsList?
        .Select(item => (ContentModels.EventItem)item.Content)
        .Where(ev => ev?.BlockVisibility != false && ev?.EventDate.Date >= DateTime.Today)
        .OrderBy(ev => ev!.EventDate)
        .ToList() ?? new List<ContentModels.EventItem>();
}

@if (events.Any())
{
    <section class="section block-events @backgroundColorClass @verticalSpacingClass @topBorderClass @classNames"
    @if (!string.IsNullOrEmpty(settings?.AnchorId))
    {
        <text>id="@settings.AnchorId"</text>
    }>
        <div class="@containerWidthClass">
            @if (!string.IsNullOrEmpty(content?.Preheading) || !string.IsNullOrEmpty(content?.Heading) || !string.IsNullOrEmpty(content?.Text?.ToString()))
            {
                <div class="@headerCenterTextClass mb-4">
                    @if (!string.IsNullOrEmpty(content?.Preheading))
                    {
                        <div class="pre-head">@content.Preheading</div>
                    }
                    @if (!string.IsNullOrEmpty(content?.Heading) && order == 0)
                    {
                        <h1 class="head display-5 bold">@content.Heading</h1>
                    }
                    else if (!string.IsNullOrEmpty(content?.Heading) && order != 0)
                    {
                        <h2 class="head display-6 bold">@content.Heading</h2>
                    }
                    @if (!string.IsNullOrEmpty(content?.Text?.ToString()))
                    {
                        <p>@content.Text</p>
                    }
                </div>
            }

            <div class="row gutters-sm">
                @foreach (var ev in events)
                {
                    var isFeatured = ev.Featured;
                    <div class="col-12 col-md-6 col-lg-4 mb-3">
                        <div class="d-flex gap-2 p-2 rounded bg-white shadow-primary-xs h-100 @(isFeatured ? "border border-2" : "")" style="@(isFeatured ? "border-color:var(--shs-gold,#c9a227) !important;" : "")">
                            <div class="flex-shrink-0 rounded text-center d-flex flex-column align-items-center justify-content-center"
                                 style="width:44px; height:48px; background:@(isFeatured ? "var(--shs-purple,#4a1f7a)" : "#f1f1f1");">
                                <span class="d-block" style="font-size:9px; font-weight:700; color:@(isFeatured ? "var(--shs-gold,#c9a227)" : "#888");">@ev.EventDate.ToString("MMM").ToUpper()</span>
                                <span class="d-block" style="font-size:16px; font-weight:700; color:@(isFeatured ? "#fff" : "#333"); line-height:1;">@ev.EventDate.Day</span>
                            </div>
                            <div class="flex-grow-1">
                                @if (!string.IsNullOrEmpty(ev.Title))
                                {
                                    <div class="fw-bold" style="font-size:0.9rem;">@ev.Title</div>
                                }
                                <div class="text-muted small">
                                    @ev.EventDate.ToString("h:mm tt")
                                    @if (!string.IsNullOrEmpty(ev.Location))
                                    {
                                        <text> &middot; @ev.Location</text>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(ev.Description?.ToString()))
                                {
                                    <div class="small mt-1">@ev.Description</div>
                                }
                                @if (ev.Link != null && !string.IsNullOrEmpty(ev.Link.Url))
                                {
                                    <a href="@ev.Link.Url" target="@(ev.Link.Target ?? "_self")" class="small">@(string.IsNullOrEmpty(ev.Link.Name) ? "More info" : ev.Link.Name) &rarr;</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
