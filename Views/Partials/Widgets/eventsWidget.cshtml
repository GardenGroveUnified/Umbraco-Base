@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Web.Common.Views
@using UmbracoBase.Core.Calendar
@using UmbracoBase.Core.Models
@inject ICalendarFeedService CalendarFeed
@{
    var content = (ContentModels.EventsWidget)Model.Content;
    var settings = (ContentModels.EventsWidgetSettings?)Model.Settings;
    if (settings?.BlockVisibility == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;
    var isHomeStyle = settings?.BlockStyle == "Style 2";

    var containerWidthClass = settings?.ContainerWidth switch
    {
        "small" => "container-md container-small",
        "standard" => "container",
        "big" => "container-xlg",
        "full width" => "container-fluid",
        _ => "container"
    };
    var backgroundColorClass = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "bg-transparent" : "";
    var backgroundColorStyle = string.IsNullOrWhiteSpace(settings?.BackgroundColor) ? "" : $"background-color:{settings.BackgroundColor};";
    var verticalSpacingClass = string.IsNullOrWhiteSpace(settings?.VerticalSpacing) ? (isHomeStyle ? "py-4" : "py-3") : settings.VerticalSpacing;
    var topBorderClass = settings?.ShowTopBorder == true ? "border-top" : "";
    var headerCenterTextClass = settings?.CenterHeading == true ? "text-center" : "text-left";
    var classNames = settings?.Classnames?.Any(s => !string.IsNullOrWhiteSpace(s)) == true
        ? string.Join(" ", settings.Classnames.Where(s => !string.IsNullOrWhiteSpace(s)))
        : string.Empty;

    var hasActionLink = content?.ActionLink != null && !string.IsNullOrEmpty(content.ActionLink.Url);

    // A Google Calendar feed URL, when set, replaces the manually entered list.
    // The feed gives title, date, time, location and description only, so those
    // cards have no photo or link. The soonest feed event is featured.
    var feedUrl = Model.Content.Value<string>("googleCalendarUrl");

    List<EventCardViewModel> events;
    if (!string.IsNullOrWhiteSpace(feedUrl))
    {
        var feed = await CalendarFeed.GetUpcomingAsync(feedUrl, daysAhead: 60, maxResults: 12);
        events = feed
            .Select((ev, i) => new EventCardViewModel
            {
                Title = ev.Title,
                Start = ev.Start,
                IsAllDay = ev.IsAllDay,
                Location = ev.Location,
                DescriptionHtml = ev.DescriptionHtml,
                Featured = i == 0,
            })
            .ToList();
    }
    else
    {
        // Only show events that are today or in the future, always sorted
        // chronologically regardless of entry order.
        events = (content?.EventsList?
            .Select(item => (ContentModels.EventItem)item.Content)
            .Where(ev => ev?.BlockVisibility != false && ev?.EventDate.Date >= DateTime.Today)
            .OrderBy(ev => ev!.EventDate)
            .Select(ev => new EventCardViewModel
            {
                Title = ev!.Title,
                Start = ev.EventDate,
                IsAllDay = false,
                Location = ev.Location,
                DescriptionHtml = ev.Description?.ToString(),
                PhotoUrl = ev.Photo?.GetCropUrl(200, 200),
                LinkUrl = ev.Link?.Url,
                LinkName = ev.Link?.Name,
                LinkTarget = ev.Link?.Target,
                Featured = ev.Featured,
            })
            .ToList()) ?? new List<EventCardViewModel>();
    }

    var hasEvents = events.Any();
}

@if (isHomeStyle)
{
        <section class="section block-events block-events-home @verticalSpacingClass @classNames"
        @if (!string.IsNullOrEmpty(settings?.AnchorId))
        {
            <text>id="@settings.AnchorId"</text>
        }>
            <div class="container-fluid px-4">
                @if (!string.IsNullOrEmpty(content?.Preheading) || !string.IsNullOrEmpty(content?.Heading) || hasActionLink)
                {
                    <div class="news-widget__header">
                        <div class="news-widget__label">
                            @if (!string.IsNullOrEmpty(content?.Preheading))
                            {
                                <span>@content.Preheading</span>
                            }
                            @if (!string.IsNullOrEmpty(content?.Heading) && order == 0)
                            {
                                <h1 class="news-widget__heading">@content.Heading</h1>
                            }
                            else if (!string.IsNullOrEmpty(content?.Heading))
                            {
                                <h2 class="news-widget__heading">@content.Heading</h2>
                            }
                        </div>
                        @if (hasActionLink)
                        {
                            <a href="@content!.ActionLink!.Url" target="@(content.ActionLink.Target ?? "_self")" class="news-widget__action">@(string.IsNullOrEmpty(content.ActionLink.Name) ? "Full calendar" : content.ActionLink.Name) &rarr;</a>
                        }
                    </div>
                }

                @if (hasEvents)
                {
                    <div class="event-home-grid">
                        @foreach (var ev in events)
                        {
                            var isFeatured = ev.Featured;

                            <div class="event-home-row">
                                <div class="event-home-row__date @(isFeatured ? "event-home-row__date--featured" : "")">
                                    <span class="event-home-row__month">@ev.Start.ToString("MMM").ToUpper()</span>
                                    <span class="event-home-row__day">@ev.Start.Day</span>
                                </div>
                                @if (!string.IsNullOrEmpty(ev.PhotoUrl))
                                {
                                    <div class="event-home-row__photo"><img src="@ev.PhotoUrl" alt="@ev.Title" /></div>
                                }
                                <div class="event-home-row__body">
                                    @if (!string.IsNullOrEmpty(ev.Title))
                                    {
                                        <div class="event-home-row__title">@ev.Title</div>
                                    }
                                    <div class="event-home-row__sub">
                                        @(ev.IsAllDay ? "All day" : ev.Start.ToString("h:mm tt"))
                                        @if (!string.IsNullOrEmpty(ev.Location))
                                        {
                                            <text> &middot; @ev.Location</text>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="event-home-row__empty">No upcoming events at this time.</div>
                }
            </div>
        </section>
    }
    else
    {
        <section class="section block-events @backgroundColorClass @verticalSpacingClass @topBorderClass @classNames" style="@backgroundColorStyle"
        @if (!string.IsNullOrEmpty(settings?.AnchorId))
        {
            <text>id="@settings.AnchorId"</text>
        }>
            <div class="@containerWidthClass">
                @if (!string.IsNullOrEmpty(content?.Preheading) || !string.IsNullOrEmpty(content?.Heading) || !string.IsNullOrEmpty(content?.Text?.ToString()))
                {
                    <div class="@headerCenterTextClass mb-4">
                        @if (!string.IsNullOrEmpty(content?.Preheading))
                        {
                            <div class="pre-head">@content.Preheading</div>
                        }
                        @if (!string.IsNullOrEmpty(content?.Heading) && order == 0)
                        {
                            <h1 class="head display-5 bold">@content.Heading</h1>
                        }
                        else if (!string.IsNullOrEmpty(content?.Heading) && order != 0)
                        {
                            <h2 class="head display-6 bold">@content.Heading</h2>
                        }
                        @if (!string.IsNullOrEmpty(content?.Text?.ToString()))
                        {
                            <p>@content.Text</p>
                        }
                    </div>
                }

                @if (hasEvents)
                {
                    <div class="row gutters-sm">
                        @foreach (var ev in events)
                        {
                            var isFeatured = ev.Featured;

                            <div class="col-12 col-md-6 col-lg-4 mb-3">
                                <div class="d-flex gap-2 p-2 rounded bg-white shadow-primary-xs h-100 @(isFeatured ? "border border-2" : "")" style="@(isFeatured ? "border-color:var(--shs-gold,#c9a227) !important;" : "")">
                                    @if (!string.IsNullOrEmpty(ev.PhotoUrl))
                                    {
                                        <div class="flex-shrink-0 rounded overflow-hidden" style="width:64px; height:64px;">
                                            <img src="@ev.PhotoUrl" alt="@ev.Title" style="width:100%; height:100%; object-fit:cover; display:block;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex-shrink-0 rounded text-center d-flex flex-column align-items-center justify-content-center"
                                             style="width:44px; height:48px; background:@(isFeatured ? "var(--shs-purple,#4a1f7a)" : "#f1f1f1");">
                                            <span class="d-block" style="font-size:9px; font-weight:700; color:@(isFeatured ? "var(--shs-gold,#c9a227)" : "#888");">@ev.Start.ToString("MMM").ToUpper()</span>
                                            <span class="d-block" style="font-size:16px; font-weight:700; color:@(isFeatured ? "#fff" : "#333"); line-height:1;">@ev.Start.Day</span>
                                        </div>
                                    }
                                    <div class="flex-grow-1">
                                        @if (!string.IsNullOrEmpty(ev.Title))
                                        {
                                            <div class="fw-bold" style="font-size:0.9rem;">@ev.Title</div>
                                        }
                                        <div class="text-muted small">
                                            @(ev.IsAllDay ? "All day" : ev.Start.ToString("h:mm tt"))
                                            @if (!string.IsNullOrEmpty(ev.Location))
                                            {
                                                <text> &middot; @ev.Location</text>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(ev.DescriptionHtml))
                                        {
                                            <div class="small mt-1">@Html.Raw(ev.DescriptionHtml)</div>
                                        }
                                        @if (!string.IsNullOrEmpty(ev.LinkUrl))
                                        {
                                            <a href="@ev.LinkUrl" target="@(ev.LinkTarget ?? "_self")" class="small">@(string.IsNullOrEmpty(ev.LinkName) ? "More info" : ev.LinkName) &rarr;</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No upcoming events at this time.</p>
                }
            </div>
        </section>
    }
