@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@{
    var content  = Model.Content;
    var settings = Model.Settings;

    if (settings?.Value<bool?>("blockVisibility") == false) { return; }

    int order = ViewData["order"] != null ? Convert.ToInt32(ViewData["order"]) : 0;

    var heading    = content.Value<string>("heading");
    var preheading = content.Value<string>("preheading");
    var text       = content.Value<IHtmlEncodedString>("text");
    var staff      = content.Value<IEnumerable<BlockListItem>>("staffList")?.ToList() ?? new List<BlockListItem>();
    var showSearch = content.Value<bool?>("showSearch") ?? true;

    // sort by surname; fall back to the full name when no lastName is set
    string SortKey(BlockListItem s)
    {
        var ln = s.Content.Value<string>("lastName");
        return (string.IsNullOrWhiteSpace(ln) ? s.Content.Value<string>("name") : ln) ?? "";
    }
    staff = staff
        .OrderBy(SortKey, StringComparer.OrdinalIgnoreCase)
        .ThenBy(s => s.Content.Value<string>("name") ?? "", StringComparer.OrdinalIgnoreCase)
        .ToList();

    var anchorId      = settings?.Value<string>("anchorId");
    var bgColor       = settings?.Value<string>("backgroundColor");
    var verticalSpace = settings?.Value<string>("verticalSpacing");
    var showTopBorder = settings?.Value<bool?>("showTopBorder") == true;
    var centerHeading = settings?.Value<bool?>("centerHeading") == true;

    var containerWidthClass = settings?.Value<string>("containerWidth") switch
    {
        "small"      => "container-md container-small",
        "standard"   => "container",
        "big"        => "container-xlg",
        "full width" => "container-fluid",
        _            => "container"
    };
    var verticalSpacingClass = string.IsNullOrWhiteSpace(verticalSpace) ? "py-3" : verticalSpace;
    var topBorderClass       = showTopBorder ? "border-top" : "";
    var backgroundColorClass = string.IsNullOrWhiteSpace(bgColor) ? "bg-transparent" : "";
    var backgroundColorStyle = string.IsNullOrWhiteSpace(bgColor) ? "" : $"background-color:{bgColor};";
    var headerCenterTextClass = centerHeading ? "text-center" : "text-left";
    var gutterSpacingClass = settings?.Value<string>("columnSpacing") is { Length: > 0 } cs ? cs : "gutters-sm";

    var columnMap = new Dictionary<string, string>
    {
        ["6"] = "col-6 col-md-4 col-lg-2",
        ["5"] = "col-6 col-md-4 col-lg-5th",
        ["4"] = "col-6 col-md-4 col-lg-3",
        ["3"] = "col-6 col-md-4",
        ["2"] = "col-12 col-sm-6",
        ["1"] = "col-12",
    };
    var itemsPerRow = settings?.Value<decimal>("itemsPerRow") ?? 0m;
    var columnClass = columnMap.GetValueOrDefault(itemsPerRow > 0 ? itemsPerRow.ToString("0") : "4", "col-6 col-md-4 col-lg-3");

    var uid = "staffdir-" + Guid.NewGuid().ToString("N").Substring(0, 8);

    // A staff member can sit in more than one department. The Department field
    // holds a comma-separated list, e.g. "Counseling, Athletics".
    static string[] DeptList(string? raw) =>
        (raw ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // distinct departments, in first-seen order
    var departments = staff
        .SelectMany(s => DeptList(s.Content.Value<string>("department")))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}

@if (staff.Any())
{
    <section class="section block-staff-directory @backgroundColorClass @verticalSpacingClass @topBorderClass" style="@backgroundColorStyle"
    @if (!string.IsNullOrEmpty(anchorId))
    {
        <text>id="@anchorId"</text>
    }>
        <div class="@containerWidthClass">
            @if (!string.IsNullOrEmpty(preheading) || !string.IsNullOrEmpty(heading) || !string.IsNullOrEmpty(text?.ToString()))
            {
                <div class="@headerCenterTextClass mb-4">
                    @if (!string.IsNullOrEmpty(preheading))
                    {
                        <div class="pre-head">@preheading</div>
                    }
                    @if (!string.IsNullOrEmpty(heading))
                    {
                        @if (order == 0)
                        {
                            <h1 class="head display-5 bold">@heading</h1>
                        }
                        else
                        {
                            <h2 class="head display-6 bold">@heading</h2>
                        }
                    }
                    @if (!string.IsNullOrEmpty(text?.ToString()))
                    {
                        <div>@text</div>
                    }
                </div>
            }

            <div class="staff-directory" id="@uid">
                @if (showSearch || departments.Any())
                {
                <div class="staff-directory__controls">
                    @if (showSearch)
                    {
                        <label class="staff-directory__search">
                            <span class="visually-hidden">Search staff</span>
                            <input type="search" placeholder="Search by name or title&hellip;" data-staffdir-search autocomplete="off" />
                        </label>
                    }
                    @if (departments.Any())
                    {
                        <div class="staff-directory__filters" role="group" aria-label="Filter by department">
                            <button type="button" class="staff-directory__filter is-active" data-staffdir-dept="">All</button>
                            @foreach (var d in departments)
                            {
                                <button type="button" class="staff-directory__filter" data-staffdir-dept="@d.ToLowerInvariant()">@d</button>
                            }
                        </div>
                    }
                </div>
                }

                @{ var dlgIndex = 0; }
                <div class="row @gutterSpacingClass staff-directory__grid">
                    @foreach (var item in staff)
                    {
                        var m = item.Content;
                        if (m.Value<bool?>("blockVisibility") == false) { continue; }

                        var name  = m.Value<string>("name");
                        var title = m.Value<string>("title");
                        var email = m.Value<string>("email");
                        var phone = m.Value<string>("phone");
                        var depts = DeptList(m.Value<string>("department"));
                        var photo = m.Value<MediaWithCrops>("photo");
                        var photoUrl = photo?.GetCropUrl(400, 400);
                        var bio   = m.Value<IHtmlEncodedString>("bio");
                        var hasBio = !string.IsNullOrWhiteSpace(bio?.ToString());
                        var dlgId  = hasBio ? $"{uid}-bio-{dlgIndex++}" : null;
                        var search = ((name ?? "") + " " + (title ?? "") + " " + string.Join(" ", depts)).ToLowerInvariant();

                        <div class="@columnClass mb-4 staff-directory__item"
                             data-staffdir-text="@search"
                             data-staffdir-dept="@string.Join("|", depts.Select(d => d.ToLowerInvariant()))">
                            <div class="staff-directory__card h-100 text-center">
                                <div class="staff-directory__photo mx-auto mb-2">
                                    @if (!string.IsNullOrEmpty(photoUrl))
                                    {
                                        <img src="@photoUrl" alt="@name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="staff-directory__initial">@(string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1))</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(name))
                                {
                                    <div class="staff-directory__name">@name</div>
                                }
                                @if (!string.IsNullOrEmpty(title))
                                {
                                    <div class="staff-directory__title">@title</div>
                                }
                                @if (depts.Any())
                                {
                                    <div class="staff-directory__dept">@string.Join(", ", depts)</div>
                                }
                                @if (!string.IsNullOrEmpty(email))
                                {
                                    <div class="staff-directory__contact"><a href="mailto:@email">@email</a></div>
                                }
                                @if (!string.IsNullOrEmpty(phone))
                                {
                                    <div class="staff-directory__contact"><a href="tel:@phone">@phone</a></div>
                                }
                                @if (hasBio)
                                {
                                    <button type="button" class="staff-directory__biolink" data-staffdir-dialog="#@dlgId" aria-haspopup="dialog">Read bio &rarr;</button>
                                }
                            </div>
                        </div>

                        @if (hasBio)
                        {
                            <dialog id="@dlgId" class="staff-directory__dialog">
                                <form method="dialog" class="staff-directory__dialog-close-form">
                                    <button class="staff-directory__dialog-close" aria-label="Close">&times;</button>
                                </form>
                                <div class="staff-directory__dialog-body">
                                    @if (!string.IsNullOrEmpty(photoUrl))
                                    {
                                        <img src="@photoUrl" class="staff-directory__dialog-photo" alt="@name" />
                                    }
                                    @if (!string.IsNullOrEmpty(name))
                                    {
                                        <h3 class="staff-directory__dialog-name">@name</h3>
                                    }
                                    @if (!string.IsNullOrEmpty(title))
                                    {
                                        <div class="staff-directory__dialog-title">@title</div>
                                    }
                                    @if (!string.IsNullOrEmpty(email))
                                    {
                                        <div><a href="mailto:@email">@email</a></div>
                                    }
                                    @if (!string.IsNullOrEmpty(phone))
                                    {
                                        <div><a href="tel:@phone">@phone</a></div>
                                    }
                                    <div class="staff-directory__dialog-bio">@bio</div>
                                </div>
                            </dialog>
                        }
                    }
                </div>

                <p class="staff-directory__empty" hidden>No staff match your search.</p>
            </div>
        </div>
    </section>

    <script>
    (function () {
        var root = document.getElementById('@uid');
        if (!root) return;
        var search = root.querySelector('[data-staffdir-search]');
        var filters = root.querySelectorAll('[data-staffdir-dept].staff-directory__filter');
        var items = root.querySelectorAll('.staff-directory__item');
        var empty = root.querySelector('.staff-directory__empty');
        var term = '';
        var dept = '';

        function apply() {
            var shown = 0;
            items.forEach(function (el) {
                var matchText = !term || (el.getAttribute('data-staffdir-text') || '').indexOf(term) !== -1;
                var cardDepts = (el.getAttribute('data-staffdir-dept') || '').split('|');
                var matchDept = !dept || cardDepts.indexOf(dept) !== -1;
                var show = matchText && matchDept;
                el.hidden = !show;
                if (show) shown++;
            });
            if (empty) empty.hidden = shown !== 0;
        }

        if (search) {
            search.addEventListener('input', function () {
                term = this.value.trim().toLowerCase();
                apply();
            });
        }
        filters.forEach(function (btn) {
            btn.addEventListener('click', function () {
                filters.forEach(function (b) { b.classList.remove('is-active'); });
                this.classList.add('is-active');
                dept = this.getAttribute('data-staffdir-dept') || '';
                apply();
            });
        });

        root.querySelectorAll('[data-staffdir-dialog]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var dlg = root.querySelector(this.getAttribute('data-staffdir-dialog'));
                if (dlg && !dlg.open && typeof dlg.showModal === 'function') { dlg.showModal(); }
            });
        });
        root.querySelectorAll('dialog.staff-directory__dialog').forEach(function (dlg) {
            dlg.addEventListener('click', function (e) { if (e.target === dlg) { dlg.close(); } });
        });
    })();
    </script>
}
