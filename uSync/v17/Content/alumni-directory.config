        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe Santiago High School Alumni Association is composed of alumni who are interested in contributing to the constant improvement of Santiago High School\u0027s well-being and helping current students achieve the highest career goals possible. We have an Annual All Alumni Reunion Picnic the first Saturday in June to help raise funds for the students at Santiago for scholarships, equipment, and supplies. At the same time, we have fun reconnecting with old friends and classmates. This past picnic brought over 200 alumni back to our campus! Since the first picnic was held in 2006, we have given out approximately 100 scholarships to college-bound students amounting to over $90,000!! Please join us in giving back to Santiago and attend the All Alumni Reunion Picnics.\u003C/p\u003E"
          }
        },
        {
