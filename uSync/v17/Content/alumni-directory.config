      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Alumni Membership Form"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EFor those of you that were unable to attend this year\u0027s reunion picnic or for those of you that did attend and got so busy visiting with everyone and forgot to renew your annual membership, have no fear - the form is attached. Annual membership dues are $10 and a lifetime membership is $100. Thank you for supporting the Alumni Association in supporting Santiago! GO CAVS!!!\u003C/p\u003E"
          }
        },
        {
          "alias": "photo",
          "culture": null,
          "editorAlias": null,
