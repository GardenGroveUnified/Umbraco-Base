  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "30a0d072-7837-449e-9db2-228afed80595",
      "key": "87554966-0001-4a01-9c01-000000000001",
      "values": [
        {
          "alias": "preheading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "About the programme"
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Army JROTC Program Overview"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe U.S. Army Junior Reserve Officers\u0027 Training Corps is one of the world\u0027s largest character development and citizenship programmes for youth. The National Defense Act of 1916 first established organised JROTC programmes in schools. Title 10 of the United States Code now requires each military service to run a JROTC programme.\u003C/p\u003E\u003Cp\u003EThe programme instils the values of citizenship, service to the United States, and personal responsibility. Its mission, \u0022to motivate young people to be better citizens\u0022, guides its work in more than 1,700 high schools in the United States and overseas.\u003C/p\u003E"
          }
        },
        {
          "alias": "photo",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "links",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "efc614c3-34dd-4262-b6f2-3514575b3ac6",
      "key": "87554966-0007-4a01-9c01-000000000007",
      "values": [
        {
          "alias": "preheading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "How the program works"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "accordionList",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "87554966-0003-4a01-9c01-000000000003",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "The JROTC curriculum"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003ESince 2005 the programme has been accredited as a Special Purpose Program by Cognia (\u003Ca href=\u0022http://www.cognia.org\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Ecognia.org\u003C/a\u003E). Every lesson uses a four-part model: motivate the cadet, teach new information, practise the skill, then apply it to a real situation. Lessons cover leadership, health and wellness, physical fitness, first aid, geography, American history and government, communication, and emotional intelligence.\u003C/p\u003E\u003Cp\u003EThe curriculum meets the Common Core State Standards, and many schools grant core credit for JROTC coursework.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "87554966-0004-4a01-9c01-000000000004",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Co-curricular activities"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003ECadets take part in activities that reinforce classroom learning:\u003C/p\u003E\u003Cul\u003E\u003Cli\u003EPrecision and exhibition drill competitions\u003C/li\u003E\u003Cli\u003EAir rifle competitions (optional)\u003C/li\u003E\u003Cli\u003ERaider Challenge competitions\u003C/li\u003E\u003Cli\u003EJROTC Leadership and Academic Bowl\u003C/li\u003E\u003Cli\u003ESTEM Camp\u003C/li\u003E\u003Cli\u003EJROTC Cadet Leadership Challenge\u003C/li\u003E\u003C/ul\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "87554966-0005-4a01-9c01-000000000005",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "College opportunities"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EThe College Options Foundation helps cadets find colleges that offer credit for completing JROTC. Army ROTC, which is separate from JROTC, offers college scholarships to cadets who qualify. See \u003Ca href=\u0022http://www.collegeoptionsfoundation.net\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Ecollegeoptionsfoundation.net\u003C/a\u003E or \u003Ca href=\u0022https://www.goarmy.com/rotc/high-school-students.html\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Egoarmy.com/rotc\u003C/a\u003E.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "87554966-0006-4a01-9c01-000000000006",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "National impact"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EJROTC tracks five quality indicators. Cadets exceed school averages in every category.\u003C/p\u003E\u003Ctable\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EIndicator\u003C/th\u003E\u003Cth\u003ESchool\u003C/th\u003E\u003Cth\u003EJROTC\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003EAttendance\u003C/td\u003E\u003Ctd\u003E90.29%\u003C/td\u003E\u003Ctd\u003E93.54%\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003EGraduation\u003C/td\u003E\u003Ctd\u003E83%\u003C/td\u003E\u003Ctd\u003E93.98%\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003EIndiscipline\u003C/td\u003E\u003Ctd\u003E5.2%\u003C/td\u003E\u003Ctd\u003E1.7%\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003EDropout\u003C/td\u003E\u003Ctd\u003E8%\u003C/td\u003E\u003Ctd\u003E\u0026lt;1%\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003EGPA\u003C/td\u003E\u003Ctd\u003E2.72\u003C/td\u003E\u003Ctd\u003E2.91\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003Cp\u003EAs an accredited Special Purpose Program, JROTC follows Cognia\u0027s Standards of Quality and runs the JROTC Program Accreditation review, which documents continuous improvement.\u003C/p\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
