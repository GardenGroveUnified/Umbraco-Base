    {
      "contentTypeKey": "30a0d072-7837-449e-9db2-228afed80595",
      "key": "a1b2c3d4-0004-4a04-9c04-aaaa00000004",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Eligibility and insurance"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003EA 2.0 grade point average is required and must stay at or above 2.0 for the whole season.\u003C/li\u003E\u003Cli\u003ENew players must have an Acknowledgement of Risk form on file.\u003C/li\u003E\u003Cli\u003EStudents without medical insurance can buy low-cost cover through \u003Ca href=\u0022https://myers-stevens.com/enrollment/\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003EMyers-Stevens\u003C/a\u003E.\u003C/li\u003E\u003C/ul\u003E"
          }
        }
      ]
    },
