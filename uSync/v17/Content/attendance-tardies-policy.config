  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "efc614c3-34dd-4262-b6f2-3514575b3ac6",
      "key": "687ff29a-f97a-4ee4-b0da-803b59154451",
      "values": [
        {
          "alias": "preheading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EDetails on verifying absences, off-campus passes, and how absences are classified at Santiago High School. Expand a section below.\u003C/p\u003E"
          }
        },
        {
          "alias": "accordionList",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "7c545b60-7e51-4bfb-9264-398a1bbb580c",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Key Contact Information"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EYou can reach the Attendance Office at \u003Cstrong\u003E(714) 663-6244\u003C/strong\u003E. Two staff members assist students, divided by last name (A-L and M-Z).\u003C/p\u003E\u003Cp\u003E\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "b087f87c-7b06-4061-a6d3-e74a02e388e6",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Core Requirements"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EParents must verify absences through a note or phone call the same day. Students have 3 days to clear marked truancies. Unverified absences result in truancy status and Saturday School assignment.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "e71790e8-edee-47ef-a924-b088ccf68634",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Absence Classifications"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u003Cstrong\u003EExcused (E):\u003C/strong\u003E Includes illness, quarantine, medical appointments, and funeral attendance.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EPermissive (P):\u003C/strong\u003E Parent-approved absences requiring prior school notification, such as court appearances or religious observances.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EUnexcused (U):\u003C/strong\u003E Absences with parental knowledge but no advance notice, including babysitting or oversleeping.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003ETruancy (T):\u003C/strong\u003E Absences without school or parental knowledge. Students receive no credit for missed work and face detention or suspension.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "c00ff4bd-2df4-43df-b59c-27eb58f56853",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Off-Campus Policy"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EStudents must obtain an office-issued pass to leave campus at any time, including lunch. Unauthorized departures result in Saturday School. Those without 1st, 5th, or 6th period classes need an ID sticker from Attendance.\u003C/p\u003E"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "8eb353ec-8eb9-46f0-995f-4202b1888436",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Distance Learning Note"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EDuring remote learning, Saturday School was replaced with parental contact and possible referral to a Truancy Reduction Center.\u003C/p\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
