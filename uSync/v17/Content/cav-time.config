    {
      "contentTypeKey": "a9d1ce00-0000-4b0e-9c22-a9d1ce000001",
      "key": "5ca77100-0003-4a03-9c03-000000000003",
      "values": [
        {
          "alias": "blockVisibility",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1"
        },
        {
          "alias": "badge",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "MANDATORY FOR D/F GRADES"
        },
        {
          "alias": "icon",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "fa fa-exclamation-triangle"
        },
        {
          "alias": "message",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "<p>Students earning a D or F in any class must attend Cav Time with that teacher until the grade improves to a C or better.</p>"
          }
        },
        {
          "alias": "link",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Enroll in 5-Star",
              "target": "_blank",
              "unique": null,
              "type": null,
              "udi": null,
              "url": "https://5starstudents.com/santiagohs/login",
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "30a0d072-7837-449e-9db2-228afed80595",
      "key": "5ca77100-0004-4a04-9c04-000000000004",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Cav Connect Mondays"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "<p>Every student is assigned one teacher for Cav Connect Mondays, held throughout the year. Monday sessions cover:</p><ul><li>School announcements</li><li>Surveys and schoolwide activities</li><li>Planning and sign-ups for that week's Tuesday, Thursday, and Friday sessions through 5-Star</li></ul><p>Your Monday teacher assignment appears on your class schedule.</p>"
          }
        }
      ]
    },
    {
      "contentTypeKey": "30a0d072-7837-449e-9db2-228afed80595",
      "key": "5ca77100-0005-4a05-9c05-000000000005",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tuesday, Thursday & Friday"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "<p>Use these Cav Time sessions to:</p><ul><li>Make up assignments and assessments</li><li>Get subject-specific tutoring</li><li>Prepare and review for tests</li><li>Build note-taking skills</li><li>Study with peers</li><li>Finish reading assignments</li></ul>"
          }
        }
      ]
    },
