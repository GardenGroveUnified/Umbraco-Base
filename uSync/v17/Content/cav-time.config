                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Enroll ahead of time"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "<p>Admission to any Cav Time session requires prior enrollment – drop-ins aren't accepted.</p>"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
