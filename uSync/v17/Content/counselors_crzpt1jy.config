                "values": [
                  {
                    "alias": "photo",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "key": "b1c05e10-0001-4001-9001-000000000001",
                        "mediaKey": "c05e1a01-0000-4a01-9a01-c0a5e5f10001",
