                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Theresa Trieu"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counselor (Ro\u2013Z)"
                  },
                  {
                    "alias": "phone",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "(714) 663-6215"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EDr. Trieu is a first-generation college student from an immigrant background, and she draws on that experience to help students navigate college and career decisions. \u0026ldquo;College and career readiness begins in high school,\u0026rdquo; she notes, and the choices students make now shape the opportunities open to them later.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EAreas of responsibility:\u003C/strong\u003E College Boost, Credit Recovery and Edgenuity, CCGI for 12th grade, scholarships, four-year college presentations, and Awards.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "45b437c3-3abe-4161-ab76-f1339c418032",
                "values": [
                  {
                    "alias": "photo",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "key": "b1c05e10-0001-4001-9001-000000000005",
                        "mediaKey": "c05e1a01-0000-4a05-9a05-c0a5e5f10005",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Maria Ure\u00F1o"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counselor (N\u2013Ri)"
                  },
                  {
                    "alias": "phone",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "(714) 663-6275"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u0026ldquo;I encourage students to reach their full potential and prepare them for post-high-school options.\u0026rdquo; Mrs. Ure\u0026ntilde;o works to make sure the school\u0026rsquo;s comprehensive guidance programme \u0026mdash; academic, college and career, and personal and social-emotional counselling \u0026mdash; meets the needs of all of her students.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EAreas of responsibility:\u003C/strong\u003E Early College Academy, university and community college liaison, Financial Aid, the 12th grade College \u0026amp; Career unit, and Community Schools.\u003C/p\u003E\u003Cp\u003EStudents and parents are welcome to reach her through the Counselling Office or by email.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              }
