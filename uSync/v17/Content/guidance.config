    {
      "contentTypeKey": "12ffd3db-dd3f-4a21-83b0-f2497907ba9b",
      "key": "767f318a-d6d8-4fc9-baa7-a1ce459ce795",
      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Counselors"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003ECounsellors are assigned by student last name. Select a counsellor to read their bio.\u003C/p\u003E"
          }
        },
        {
          "alias": "preheading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "staffList",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "a65671f9-62d7-4148-bbb0-5788ea6835e3",
                "values": [
                  {
                    "alias": "photo",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "key": "b1c05e10-0001-4001-9001-000000000001",
                        "mediaKey": "c05e1a01-0000-4a01-9a01-c0a5e5f10001",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Judith Hermosillo"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counselor (Hi\u2013M)"
                  },
                  {
                    "alias": "phone",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "(714) 663-6275"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u0026ldquo;It is my goal to help our students not only be great scholars and critical thinkers, but to be kind and thoughtful citizens as well.\u0026rdquo; Ms. Hermosillo takes a whole-student approach to counselling, paying attention to all of the different facets that influence a student\u0026rsquo;s daily experience.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EAreas of responsibility:\u003C/strong\u003E Aspire (school-based mental health), College Boost, Summer School, 9th grade units, Senior Awards, local scholarships and PBIS.\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EEducation:\u003C/strong\u003E M.S. in Counselling and PPS Credential, California State University, Long Beach; B.A. in Sociology, California State University, Fullerton.\u003C/p\u003E\u003Cp\u003EPlease do not hesitate to reach out at any time.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "9abb6525-289d-45cf-8267-39b642aab2cb",
                "values": [
                  {
                    "alias": "photo",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "key": "b1c05e10-0001-4001-9001-000000000002",
                        "mediaKey": "c05e1a01-0000-4a02-9a02-c0a5e5f10002",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Maricela Montes"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counselor (A\u2013C)"
                  },
                  {
                    "alias": "phone",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "(714) 663-6275"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u0026ldquo;I\u0026rsquo;ve had the great honour of being a school counsellor here at Santiago High School for the past 20 years.\u0026rdquo; Santiago is especially meaningful to Ms. Montes, who is herself a graduate of the school (Class of 1996).\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EAreas of responsibility:\u003C/strong\u003E Department Chair, Master Schedule, 9\u0026ndash;12 registration, College Signing Day, special student programs, the Senior Survey, and College \u0026amp; Career instruction for 11th graders.\u003C/p\u003E\u003Cp\u003EStudents and families are welcome to email her or visit the Counselling Office with any questions or concerns.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "8c2ebffe-6763-4383-b13c-8f67f7b3c553",
                "values": [
                  {
                    "alias": "photo",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "key": "b1c05e10-0001-4001-9001-000000000003",
                        "mediaKey": "c05e1a01-0000-4a03-9a03-c0a5e5f10003",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ben Ramirez"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counselor (D\u2013He)"
                  },
                  {
                    "alias": "phone",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "(714) 663-6275"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u0026ldquo;I do my best to help every one of my students find success and be prepared for life after graduation.\u0026rdquo;\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EAreas of responsibility:\u003C/strong\u003E AP Testing Coordinator, Simon Scholars liaison, the 9th grade CCGI career unit, the Senior Newsletter, PBIS, and support for CTE programmes.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
