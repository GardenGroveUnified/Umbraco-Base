                "values": [
                  {
                    "alias": "grade",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "9th Grade"
                  },
                  {
                    "alias": "items",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Build your 4-year plan with your counselor\r\nExplore clubs, sports and career interests\r\nProtect your GPA from day one"
                  },
                  {
                    "alias": "current",
                    "culture": null,
                    "editorAlias": null,
