                "values": [
                  {
                    "alias": "grade",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "10th Grade"
                  },
                  {
                    "alias": "items",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Take the PSAT in October\r\nMeet your counselor to review your plan\r\nStart visiting college campuses"
                  },
                  {
                    "alias": "current",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "0"
