                "key": "24f41afb-7fbb-4b80-a211-50d9fd408c85",
                "values": [
                  {
                    "alias": "grade",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "12th Grade"
                  },
                  {
                    "alias": "items",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Submit UC and CSU applications by November 30\r\nComplete the FAFSA or CA Dream Act application\r\nApply for scholarships every month"
