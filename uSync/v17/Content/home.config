          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "4275d06e-5d8f-4785-bc5a-9fd26ba2ce27",
                "key": "5cc70d13-079a-4b4c-a8a5-30218ff4bfe1",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "California Distinguished School"
                  },
                  {
                    "alias": "photo",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "key": "6968773d-2ee9-418e-b6a0-59cf7ffe2d33",
                        "mediaKey": "c25f8426-8d65-4dd2-8d08-348795784412",
