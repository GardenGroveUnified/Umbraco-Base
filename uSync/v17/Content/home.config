                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003ECongratulations, Cavaliers - Santiago has been recognized as a California Distinguished School!\u003C/p\u003E\u003Cdiv\u003EWe earned this from EVERYONE\u2019S dedication and hard work. \u0026nbsp;It takes an entire school to create a warm, safe, clean, and welcoming place for students to feel comfortable learning, taking risks in their learning, and being involved. \u0026nbsp; This is a tribute to the hard work of all our staff, students, and their families. \u0026nbsp;More to Come!\u003C/div\u003E\u003Cdiv\u003E\u0026nbsp;\u003C/div\u003E\u003Cdiv\u003ESantiago earned this for Achievement Gap Closers: schools that accelerate academic progress for two or more historically underserved groups, while also demonstrating achievement for all students above the state median and maintaining or increasing academic performance for all students.\u003C/div\u003E\u003Cp\u003E\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              }
            ],
