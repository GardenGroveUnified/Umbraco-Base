        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "<p>Rules for using the internet and electronic communications on the Santiago High School campus.</p>"
          }
        },
        {
          "alias": "accordionList",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "43a555bf-9b33-4a49-b81a-67c729d9504d",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Acceptable Use"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "<p>Any student who uses their Internet access privileges in an inappropriate manner (including, but not limited to, visiting inappropriate websites or sending inappropriate e-mails or instant messages) may be assigned to detention, Saturday School, or suspension. In addition, the student may have his/her Internet access privileges revoked.</p>"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ef33a691-ec90-4004-8937-73a37ac2a60c",
                "key": "29b52292-e259-4aa9-916d-4ff60a776312",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Monitoring & Privacy"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "<p>There is NO right to privacy while using electronic communications on campus. Internet and e-mail use is monitored and can be used against a student by school officials or the police. See the Personal Internet Sites/Blogs policy to find out what students may or may not post on the Internet.</p>"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "43a555bf-9b33-4a49-b81a-67c729d9504d",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "29b52292-e259-4aa9-916d-4ff60a776312",
                "culture": null,
                "segment": null
              }
            ],
