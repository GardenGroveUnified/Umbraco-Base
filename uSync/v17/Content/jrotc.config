          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003ESantiago High School hosts an Army Junior Reserve Officers\u0027 Training Corps unit, the Cavalier Battalion. JROTC is a character development and citizenship programme for high school students. It carries no military service obligation.\u003C/p\u003E"
          }
        },
