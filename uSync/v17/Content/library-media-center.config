  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "102029c0-3a48-4c8b-9558-a5ef271af5f8",
      "key": "47e2129e-5b2e-4415-b886-60e6326aac63",
      "values": [
        {
          "alias": "customHtml",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"library-media\">\n  <style>\n    body:not(.layout-admin) .block-custom-code:has(.library-media) { padding-top: 1.5rem; padding-bottom: 2.5rem; }\n    .library-media { --lib-purple: var(--shs-purple, #4a1f7a); --lib-gold: var(--shs-gold, #c9a227); --lib-pale: var(--shs-purple-pale, #f3edfa); font-family: var(--font-nav-and-texts, \"Nunito\", sans-serif); color: #333; }\n    .library-media p { line-height: 1.55; }\n    .library-media h2 { color: var(--lib-purple); font-weight: 800; font-size: 1.5rem; margin: 32px 0 6px; }\n    .library-media h3 { color: var(--lib-purple); font-weight: 700; font-size: 1.05rem; margin: 0 0 10px; }\n    .library-login { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 22px; background: var(--lib-pale); border-left: 5px solid var(--lib-gold); border-radius: 8px; padding: 14px 20px; margin: 18px 0 8px; }\n    .library-login strong { color: var(--lib-purple); text-transform: uppercase; letter-spacing: .03em; font-size: .8rem; }\n    .library-login code { background: #fff; border: 1px solid #ddd; border-radius: 4px; padding: 1px 7px; font-size: .95rem; }\n    .library-db-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin: 14px 0; }\n    .library-db { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; background: #fff; border: 1px solid #e6e0f0; border-top: 3px solid var(--lib-purple); border-radius: 8px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); transition: box-shadow .15s, transform .15s; }\n    .library-db:hover { box-shadow: 0 4px 14px rgba(74,31,122,.18); transform: translateY(-2px); }\n    .library-db__name { font-weight: 700; color: var(--lib-purple); font-size: 1.05rem; }\n    .library-db__desc { font-size: .88rem; color: #555; line-height: 1.4; }\n    .library-summary { margin: 6px 0 4px; font-size: .92rem; }\n    .library-quicklinks { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0 4px; }\n    .library-quicklinks a { background: var(--lib-purple); color: #fff; font-weight: 600; text-decoration: none; padding: 9px 18px; border-radius: 6px; font-size: .9rem; }\n    .library-quicklinks a:hover { background: var(--lib-gold); }\n    .library-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 16px 0 8px; }\n    .library-card { background: var(--lib-pale); border-radius: 10px; padding: 20px 22px; }\n    .library-card p { margin: 0 0 10px; font-size: .95rem; }\n    .library-card p:last-child { margin-bottom: 0; }\n    .library-card a { color: var(--lib-purple); font-weight: 600; }\n  </style>\n\n  <p class=\"library-media__intro\">Research databases, the library catalogue, opening hours and contact details for the Santiago High School Library Media Center.</p>\n\n  <div class=\"library-login\">\n    <strong>General database login</strong>\n    <span>Username: <code>santiago</code></span>\n    <span>Password: <code>student</code></span>\n  </div>\n\n  <h2>Research databases</h2>\n  <p>Select a database to open it in a new tab. Use the general login above if you are prompted.</p>\n\n  <div class=\"library-db-grid\">\n    <a class=\"library-db\" href=\"https://www.jstor.org/\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">JSTOR</span>\n      <span class=\"library-db__desc\">Journals, books and primary source documents across more than 175 subjects. Broad single research resource for intermediate to advanced work.</span>\n    </a>\n    <a class=\"library-db\" href=\"https://search.proquest.com/\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">ProQuest</span>\n      <span class=\"library-db__desc\">College level database of journals, books and primary source documents for intermediate to advanced researchers.</span>\n    </a>\n    <a class=\"library-db\" href=\"https://search.proquest.com/centralk12/?accountid=193134\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">CentralK12</span>\n      <span class=\"library-db__desc\">ProQuest resources for the beginning researcher, with a simpler interface.</span>\n    </a>\n    <a class=\"library-db\" href=\"http://discoverer.prod.sirs.com/discoweb/disco/do/frontpage\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">SIRS Discoverer</span>\n      <span class=\"library-db__desc\">Science, technology, news, education and social sciences. Suitable for all levels.</span>\n    </a>\n    <a class=\"library-db\" href=\"https://sks.sirs.com/webapp/issues-researcher\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">ProQuest Issues &amp; Researcher</span>\n      <span class=\"library-db__desc\">Pro and con articles on health, social, historic, economic, business, political and global issues.</span>\n    </a>\n    <a class=\"library-db\" href=\"https://school.eb.com/levels\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">Britannica School (English)</span>\n      <span class=\"library-db__desc\">Articles, images, dictionary, magazines and videos at three reading levels.</span>\n    </a>\n    <a class=\"library-db\" href=\"https://escolar.eb.com/levels\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">Britannica Escolar (Spanish)</span>\n      <span class=\"library-db__desc\">Spanish language edition of Britannica School.</span>\n    </a>\n    <a class=\"library-db\" href=\"https://online.culturegrams.com/\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"library-db__name\">CultureGrams</span>\n      <span class=\"library-db__desc\">Cultural information on the countries of the world.</span>\n    </a>\n  </div>\n\n  <p class=\"library-summary\"><a href=\"https://4.files.edl.io/17a3/12/21/18/222706-dbe47855-3afc-4359-868e-4262a6328f1a.docx\" target=\"_blank\" rel=\"noopener\">Download the databases summary (DOCX)</a></p>\n\n  <div class=\"library-quicklinks\">\n    <a href=\"https://search.follettsoftware.com/metasearch/ui/72612\" target=\"_blank\" rel=\"noopener\">Library catalogue</a>\n    <a href=\"https://docs.google.com/forms/d/e/1FAIpQLSf0IcbWXqy7toftNBAI6onw1wsiyS8Czl51_pMJMQmxLDUVFw/viewform\" target=\"_blank\" rel=\"noopener\">Sign in to the library</a>\n  </div>\n\n  <div class=\"library-info-grid\">\n    <div class=\"library-card\">\n      <h3>Hours</h3>\n      <p>Monday to Thursday<br>6:45 am &ndash; 6:00 pm</p>\n      <p>Friday<br>6:45 am &ndash; 4:00 pm</p>\n    </div>\n    <div class=\"library-card\">\n      <h3>How to reach us</h3>\n      <p>Phone: (714) 663-6082</p>\n      <p>Intercom line: 137</p>\n    </div>\n    <div class=\"library-card\">\n      <h3>Staff</h3>\n      <p><strong>Ms. Heather Eckert</strong><br>Librarian</p>\n      <p><a href=\"mailto:Heckert@ggusd.us\">Heckert@ggusd.us</a></p>\n    </div>\n  </div>\n</div>\n"
        },
        {
          "alias": "blockVisibility",
