  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "102029c0-3a48-4c8b-9558-a5ef271af5f8",
      "key": "47e2129e-5b2e-4415-b886-60e6326aac63",
      "values": [
        {
          "alias": "customHtml",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u003Cdiv class=\u0022library-media\u0022\u003E\n  \u003Cstyle\u003E\n    body:not(.layout-admin) .block-custom-code:has(.library-media) { padding-top: 1.5rem; padding-bottom: 2.5rem; }\n    .library-media { --lib-purple: var(--shs-purple, #4a1f7a); --lib-gold: var(--shs-gold, #c9a227); --lib-pale: var(--shs-purple-pale, #f3edfa); font-family: var(--font-nav-and-texts, \u0022Nunito\u0022, sans-serif); color: #333; }\n    .library-media p { line-height: 1.55; }\n    .library-media h2 { color: var(--lib-purple); font-weight: 800; font-size: 1.5rem; margin: 32px 0 6px; }\n    .library-media h3 { color: var(--lib-purple); font-weight: 700; font-size: 1.05rem; margin: 0 0 10px; }\n    .library-login { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 22px; background: var(--lib-pale); border-left: 5px solid var(--lib-gold); border-radius: 8px; padding: 14px 20px; margin: 18px 0 8px; }\n    .library-login strong { color: var(--lib-purple); text-transform: uppercase; letter-spacing: .03em; font-size: .8rem; }\n    .library-login code { background: #fff; border: 1px solid #ddd; border-radius: 4px; padding: 1px 7px; font-size: .95rem; }\n    .library-db-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin: 14px 0; }\n    .library-db { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; background: #fff; border: 1px solid #e6e0f0; border-top: 3px solid var(--lib-purple); border-radius: 8px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); transition: box-shadow .15s, transform .15s; }\n    .library-db:hover { box-shadow: 0 4px 14px rgba(74,31,122,.18); transform: translateY(-2px); }\n    .library-db__name { font-weight: 700; color: var(--lib-purple); font-size: 1.05rem; }\n    .library-db__desc { font-size: .88rem; color: #555; line-height: 1.4; }\n    .library-summary { margin: 6px 0 4px; font-size: .92rem; }\n    .library-quicklinks { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0 4px; }\n    .library-quicklinks a { background: var(--lib-purple); color: #fff; font-weight: 600; text-decoration: none; padding: 9px 18px; border-radius: 6px; font-size: .9rem; }\n    .library-quicklinks a:hover { background: var(--lib-gold); }\n    .library-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 16px 0 8px; }\n    .library-card { background: var(--lib-pale); border-radius: 10px; padding: 20px 22px; }\n    .library-card p { margin: 0 0 10px; font-size: .95rem; }\n    .library-card p:last-child { margin-bottom: 0; }\n    .library-card a { color: var(--lib-purple); font-weight: 600; }\n  \u003C/style\u003E\n\n  \u003Cp class=\u0022library-media__intro\u0022\u003EResearch databases, the library catalogue, opening hours and contact details for the Santiago High School Library Media Center.\u003C/p\u003E\n\n  \u003Cdiv class=\u0022library-login\u0022\u003E\n    \u003Cstrong\u003EGeneral database login\u003C/strong\u003E\n    \u003Cspan\u003EUsername: \u003Ccode\u003Esantiago\u003C/code\u003E\u003C/span\u003E\n    \u003Cspan\u003EPassword: \u003Ccode\u003Estudent\u003C/code\u003E\u003C/span\u003E\n  \u003C/div\u003E\n\n  \u003Ch2\u003EResearch databases\u003C/h2\u003E\n  \u003Cp\u003ESelect a database to open it in a new tab. Use the general login above if you are prompted.\u003C/p\u003E\n\n  \u003Cdiv class=\u0022library-db-grid\u0022\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://www.jstor.org/\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003EJSTOR\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003EJournals, books and primary source documents across more than 175 subjects. Broad single research resource for intermediate to advanced work.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://search.proquest.com/\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003EProQuest\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003ECollege level database of journals, books and primary source documents for intermediate to advanced researchers.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://search.proquest.com/centralk12/?accountid=193134\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003ECentralK12\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003EProQuest resources for the beginning researcher, with a simpler interface.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022http://discoverer.prod.sirs.com/discoweb/disco/do/frontpage\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003ESIRS Discoverer\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003EScience, technology, news, education and social sciences. Suitable for all levels.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://sks.sirs.com/webapp/issues-researcher\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003EProQuest Issues \u0026amp; Researcher\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003EPro and con articles on health, social, historic, economic, business, political and global issues.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://school.eb.com/levels\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003EBritannica School (English)\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003EArticles, images, dictionary, magazines and videos at three reading levels.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://escolar.eb.com/levels\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003EBritannica Escolar (Spanish)\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003ESpanish language edition of Britannica School.\u003C/span\u003E\n    \u003C/a\u003E\n    \u003Ca class=\u0022library-db\u0022 href=\u0022https://online.culturegrams.com/\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n      \u003Cspan class=\u0022library-db__name\u0022\u003ECultureGrams\u003C/span\u003E\n      \u003Cspan class=\u0022library-db__desc\u0022\u003ECultural information on the countries of the world.\u003C/span\u003E\n    \u003C/a\u003E\n  \u003C/div\u003E\n\n  \u003Cp class=\u0022library-summary\u0022\u003E\u003Ca href=\u0022https://4.files.edl.io/17a3/12/21/18/222706-dbe47855-3afc-4359-868e-4262a6328f1a.docx\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003EDownload the databases summary (DOCX)\u003C/a\u003E\u003C/p\u003E\n\n  \u003Cdiv class=\u0022library-quicklinks\u0022\u003E\n    \u003Ca href=\u0022https://search.follettsoftware.com/metasearch/ui/72612\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003ELibrary catalogue\u003C/a\u003E\n    \u003Ca href=\u0022https://docs.google.com/forms/d/e/1FAIpQLSf0IcbWXqy7toftNBAI6onw1wsiyS8Czl51_pMJMQmxLDUVFw/viewform\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003ESign in to the library\u003C/a\u003E\n  \u003C/div\u003E\n\n  \u003Cdiv class=\u0022library-info-grid\u0022\u003E\n    \u003Cdiv class=\u0022library-card\u0022\u003E\n      \u003Ch3\u003EHours\u003C/h3\u003E\n      \u003Cp\u003EMonday to Thursday\u003Cbr\u003E6:45 am \u0026ndash; 6:00 pm\u003C/p\u003E\n      \u003Cp\u003EFriday\u003Cbr\u003E6:45 am \u0026ndash; 4:00 pm\u003C/p\u003E\n    \u003C/div\u003E\n    \u003Cdiv class=\u0022library-card\u0022\u003E\n      \u003Ch3\u003EHow to reach us\u003C/h3\u003E\n      \u003Cp\u003EPhone: (714) 663-6082\u003C/p\u003E\n      \u003Cp\u003EIntercom line: 137\u003C/p\u003E\n    \u003C/div\u003E\n    \u003Cdiv class=\u0022library-card\u0022\u003E\n      \u003Ch3\u003EStaff\u003C/h3\u003E\n      \u003Cp\u003E\u003Cstrong\u003EMs. Heather Eckert\u003C/strong\u003E\u003Cbr\u003ELibrarian\u003C/p\u003E\n      \u003Cp\u003E\u003Ca href=\u0022mailto:Heckert@ggusd.us\u0022\u003EHeckert@ggusd.us\u003C/a\u003E\u003C/p\u003E\n    \u003C/div\u003E\n  \u003C/div\u003E\n\u003C/div\u003E\n"
        },
