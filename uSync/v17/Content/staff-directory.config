                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Madame Ariene Borutzki"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Borutzki"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "World Language Teacher and Co-Dept Chair, Drill Coach"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "World Language"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003ESalut! Je m\u0027appelle Mme Borutzki. I teach the language and culture of the francophone world in French 1-4 here at SHS. My goal is to deepen insights into how we are all the same, celebrate what makes us different, and to inspire students to become global citizens through our course of study. I aim to provide rich and varied instruction through the use of acquisition driven instruction and to inspire a love of the language in my students.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
