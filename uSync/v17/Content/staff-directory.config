              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "beda97fa-92e3-41d4-aa85-7a8872fd832e",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Shannon Bennett"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Bennett"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Health and ELD Dept Chair"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ELD"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EHealth is a course designed to provide you the opportunity to examine and increase your knowledge for healthful living and learn through skills based instruction. Thought and discussion will be strongly encouraged daily! One goal I have for all of my students is for each one to take personal responsibility for his or her own health and well being. I look forward to great discussions, learning about all of you, and promoting a safe, healthy lifestyle! \u0022The greatest wealth is health.\u0022 -Virgil In addition to teaching health, I am advisor for the club Friday Night Live. If you want to get involved with leadership, making a positive impact at Santiago and in the community, feel free to attend a lunch meeting on any Tuesday. We always welcome new members and there is so much to be done!\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
