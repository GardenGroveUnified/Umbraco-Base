              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "66edfc42-d001-4456-a475-f64e2f5f8104",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Tina Leigh Heiland"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Heiland"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Yearbook, Journalism and Video Advisor, Visual Arts and Technology Instructor and CTE Department Chair"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Visual Arts"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EHello, this is year 19 for me here at Santiago. I have met so many wonderful students and have had the privilege of watching them grow and transform before my eyes. I love it when my students come back and share their experiences and successes. I have observed their talents bloom and dreams come to fruition, it\u0027s a wonderful experience for me. I am currently the Advisor for Yearbook, YFMS, Purple Press and SkillsUSA. A little info about me...I am a teacher and a visual artist, designer, and special effects artist. I am a UCI graduate. I hold a B.A. in Psychology, a B.A. in Studio Art with a minor in Digital Arts. I also hold an M.S. in Educational Technology, an M.Ed. in Education and a Clear/CLAD California Teaching Credential and CTE Credentials in Fashion/Interior Design, Product Design, and Manufacturing and Arts \u0026amp;Entertainment. I am also a certified Adobe Trainer. I am certified in animation, graphics, web design, photography, video production, film and special and visual effects, film history. I continue to stay abreast of the industry standards in art and technology and makeup, prosthetics and special effects. I have been in the entertainment and design industry for 23 years. I have been teaching for 21years, college 6 and high school 19. I work with various mediums such as photography, film, sculpture, computer graphics, multimedia, and mixed media. I am currently a part-time professor through the Coast Colleges and have course opportunities for Santiago students to enroll and gain college credit on the college campus. In addition, I just completed my 16 month Administration Credential Program. I have 2 illustrated published children\u2019s\u2019 books and I am currently writing my first fictional story and someday hope to have it published. I have my own studio and create in my spare time. I work with various arts organizations and volunteer when I can. I am a licensed esthetician, makeup artist, and stylist. I am currently working on special effects for small budget films and runway events. I have two daughters, Chazleigh and Mattisyn and two sons Brandon and Chase and furry kids Sullivan the 80-pound German Shepherd puppy, Stella the rat Terrier and Scout the tuxedo long hair cat. I love working in my studio, science fiction, music, podcast, reading, traveling, watching films, taking pictures and video, listening to Blues, cooking, dancing, playing the drums, gardening, work with animals, volunteering and just having fun (oh and shopping).\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
