              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "3b0436cb-f495-4737-99fd-ce6137886818",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Brandon Croft"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Croft"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "PE Teacher, Track and Field"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Physical Education"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome to Room 505! My name is Mr. Croft and this is my fourth year teaching at Santiago High School and my fourteenth year in the district. I love teaching Santiago\u0027s Seniors in ERWC/English4P. I received my Bachelor\u0027s Degree in English Literature from the University of Redlands in Redlands, California. I also completed my Master\u0027s Degree in Cross-Cultural Teaching. When I am not in the classroom I truly enjoy spending my time as the head coach of the Santiago High School Football Team. My wife and I have been blessed with two wonderful children, our daughter Mika(4) and our son Gunner (1) and we are all excited to be part of the Cavalier Family.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "baf3ec99-c186-4ea7-9bc7-a40a6fef2bd2",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Susana Diaz"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Diaz"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ELD and Physical Education Teacher, Cross Country, Track and Field"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "ELD"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome to my home page. I am an ELD Engligh Language Development) Teacher, the Gilrls Cross-Country Coach and the Distance Track Coach. If you have any questions regarding the progress in the classroom or cross-country/track ralated, contact the school phone number and leave a message.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
