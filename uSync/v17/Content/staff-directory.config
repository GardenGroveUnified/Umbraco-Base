              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "5797bba0-5297-4c6e-8474-87b1f31429a4",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Vicky Lieu"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Lieu"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Science Teacher (Chemistry \u0026 Physics) and Dept Chair"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Science"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome Santiago Cavaliers! It is a honor and pleasure to serve as your chemistry, physics or AP Physics 1 teacher this year. I am super excited to see the amazing things we will learn learn, explore and create together. I have been at Santiago High School since 2012 and hope to remain here for as long as I can. Go Cavs. My objective is to provide as much support and help to ensure your success in my classroom. One of my favorite quote is that \u0022Your success is dependent on you asking questions.\u0022 Lastly, I strongly believe in welcoming my students to make mistakes in the classroom so they can learn from them. Short Biography I graduated from University of California in Irvine with my B.S. in chemistry and my single-subject teaching credential in 2011 and 2012. In addition, I have earned my Masters of Arts in teaching and instruction in 2015. I am serving as the club advisor for Class of 2024, Club of Sciences, AP Sciences Club, and the UCI MESA Club. To reach me: If you have any questions please don not hesitate to contact me via my email. I look forward to meeting and working with you this year. Additional tutoring: I offered tutoring in the morning starting at 7:30 am, during lunch, and after-school almost daily. I can also be found tutoring in the library.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "6d7e9874-3f68-417d-b980-f45487e353e5",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Will Okura"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Okura"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Art Teacher"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Visual Arts"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EI\u0027m William Okura. It has been my pleasure of teaching Exploratory Arts, Painting and Drawing and AP Studio for over 18 years here at Santiago High School. I look forward to many more! Working with the students here has been deeply rewarding. I\u0027ve had the joy of seeing student artists stretching themselves technically, as well as emotionally to break through countless personal barriers. Whatever path my students choose for their future, I know they will take their developed skill and tenacity to pursue positive goals.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
