              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "8f3acd26-eb2f-4493-81bb-69c41fcb6327",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Shannon MacRill"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "MacRill"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "PE Teacher and Dept Chair, Volleyball"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Physical Education"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EThank you for browsing my web page. Here is some info about me, my classes and extracurricular activities. I am married and have 2 year old son who keeps me busy. I teach 9th grade periods 1-4 and 10-12th grade 5th period. I also coach Freshman/Sophomore Volleyball during 6th period and after school. Volleyball tryouts start every spring and all through summer. Summer league is for the month of July and tryouts for incoming freshmen start the last 3 weeks of August. (usually around the 13th). I am one of the Girls League (service club) advisers and the club meets every Tues. at lunch. I have attached the syllabus for Physical Education so you can browse the requirements.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
