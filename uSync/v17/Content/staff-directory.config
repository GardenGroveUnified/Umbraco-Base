                    "segment": null,
                    "value": "Social Science Teacher"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Social Science"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EIt is a pleasure to be at Santiago High School. This is my sixteenth year at SHS. The students at Santiago are what make the school so strong and unique. I would not want to work anywhere else. This year I am teaching three classes of AP World History and two classes of World History P. All students are welcome to visit me with any questions or concerns before school, during lunch, or during Cav Time. You may also contact me through e-mail. I\u0027m looking forward to a great year!\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "f2b23beb-da1e-475d-b09b-8883cb8ef4cb",
