                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003ESchedule 2023-2024 Period 1: Civics Period 2: Civics Period 3:Civics Period 4: U.S. History Period 5: U.S. History Period 6: Conference Period 9: Online Civics Tutoring is available in the library every day after school or in room 101 before \u0026amp; after school and at CAV time. I have been teaching Social Science/History since 1996. I have taught every subject and every grade level (6-12) in Social Science/History. I obtained my BA from UC Irvine and Teaching Credential in Social Science from CSUFullerton. Currently, I am a Cooperating Teacher and in charge of the State Seal of Civic Engagement. All assignments can be found on Google Classroom.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
