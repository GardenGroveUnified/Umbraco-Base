                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counseling"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EHello Santiago Family! It is a pleasure and honor to serve the students and families of Santiago High School. My philosophy is to work with students in a comprehensive way, looking at the whole student and all of the different facets that influence their daily experience. It is my goal to help our students not only be great scholars and critical thinkers, but to be kind and thoughtful citizens as well. I look forward to helping our students thrive and reach their goals, whatever that might look like for each of them. Responsibilities: Aspire (School Based Mental Health) College Boost Summer School 9th Grade Units Senior Awards Local Scholarships PBIS Member Education: M.S. in Counseling and PPS Credential-California State University, Long Beach B.A. in Sociology-California State University, Fullerton Please do not hesitate to reach out to me at any time. We are here to serve our students, their families and our community. Be well, Judith Hermosillo, Counselor\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
