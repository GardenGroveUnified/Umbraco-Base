              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "5b740fc4-c2e0-4739-9b9a-5fdd018c8584",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Will Stapatyanon"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Stapatyanon"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Social Science Teacher"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Social Science"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EMr. Stapatyanon\u0027s Course Schedule and about him Period 0: US History AP Period 1: US History AP Period 2: US History AP Period 3: Conference Period 5: US History AP Period 6: None Period 9: Online Economic This is my 21st year teaching at Santiago High School. I currently teach US History AP, US History P and Online Economics I LOVE the classes I teach and the students that I\u0027ve had. I find History fascinating because they are all events that have happened and shape who we are as a society today. My style of teaching is to make history as relatable as possible as I ask my students questions that are a combination of what we have already learned and their opinions on social science topics. I also love using metaphors as an analogy to what has happened in history so we may connect to the past and learn from our successes and mistakes. I am also the proud advisor of Boy\u0027s League or as we call it here at Santiago, the League of Extraordinary Gentlemen. Our purpose is to create a brotherhood through social events and giving back to the community. Below you can see pictures of our past posters for No Shave November. When I\u0027m not in the classroom with my amazing students, I spend most of my time with my wife Nancy, son Ben, and daughter Ellie. We love going to Disneyland and taking vacations to see the world while practicing my hobby of photography. I am also a big time foodie while trying delicious foods from all cultures. When at home, I enjoy watching tv shows/movies, playing video games, and expanding my history knowledge to bring into the classroom. If you, student or guardian, ever need anything... please visit me in room 108 or email me. Lets make this a memorable school year!!!\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
