                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "96cfcc38-d969-4506-b43a-cd16f0d6c7b6",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Amy Lillis"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Lillis"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Science Teacher"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Science"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome to science! I am looking forward to a great year with you. Please feel free to contact me if you have any questions. You can find me in room 311 before and after school. Come by anytime you need help. Chemistry is a college prep class that also fulfills one of the two years of science requirements for graduation. Supplies: Paper, 2 composition books, writing instruments, colored pencils, glue, expo marker, a stapler, a scientific calculator (Casio recommended) and a highlighter. Homework will be updated via Google Classroom. A few things about me. I hold a bachelors of science in biology and a bachelors of arts in human development from UC San Diego, as well as, a masters degree in education from CSU Fullerton. I love spending time with my husband and my son. Some of my hobbies include baking, cake decorating, and trying out new recipes (but I do not enjoy doing dishes!).\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "44f41d07-7585-4465-858c-ebab2362e521",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Leslie Alpert"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Alpert"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Social Science Teacher and Dept Chair"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Social Science"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EI am proud to be starting my 23rd year at Santiago High School. Santiago truly is the best place to work because of our incredible students, supportive teacher friends and colleagues, and dedicated administrative team. I currently teach Advanced Placement Human Geography and Ethnic Studies. Additionally, I am actively involved on campus as the advisor for the Red Cross Club, the History and Geography Club, and the National Honor Society. I also serve as the chairwoman for the History-Social Science Department. Outside of school, I enjoy going on adventures with my family, exploring new foods, traveling, and reading. I\u2019m excited for an amazing school year with you! Go CAVS!\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "1662a2e9-3763-4e5f-a37e-c4f5ab220774",
