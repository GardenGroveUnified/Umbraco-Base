                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Jeanne Wu"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Wu"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "English Teacher"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "English"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome! My name is Ms. Wu and I teach English 2H and AP Language and Composition. This is my 19th year teaching at Santiago HS and I love being here. Our Cavs are the absolute best and I love getting to work with my awesome teacher friends :) I received my BA in English and Master of Arts Degree in Teaching from the University of California, Irvine. In addition to teaching my English 2H/3AP classes, I am also the co-advisor for CSF and advisor for CHOC and Unified club! If I\u0027m not in my classroom with my lovable (and silly) kiddos, you can find me traveling, eating, or living up life with my son Emerson, friends, and family. If you need help (with anything), come by my classroom!\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
