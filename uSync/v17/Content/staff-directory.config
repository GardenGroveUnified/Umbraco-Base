              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "57292546-0b9a-4f2a-956b-a5bb058b8e18",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Kim Tachibana"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Tachibana"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
