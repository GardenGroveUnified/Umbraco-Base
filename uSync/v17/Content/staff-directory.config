                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counselor (A-C)"
                  },
                  {
                    "alias": "phone",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "(714) 663-6275"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Counseling"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EHello Santiago Students and Families, I\u2019ve had the great honor of being a school counselor here at Santiago High School for the past 20 years. I proudly serve students with last names A-C. Santiago is a place that is extremely special to me since I am a graduate of Santiago HS myself - Class of 1996! It is wonderful to be back \u0022home\u0022 and have the pleasure of working with such a dedicated staff and wonderful students. In addition to serving my students with their academic, career, and personal/social needs, I am also responsible for overseeing the following counseling responsibilities: Serve as Department Chair Master Schedule 9-12 Registration College Signing Day Special Student Programs Senior Survey College and Career Lessons for 11th Grade I look forward to a great 2025-2026 school year and to have the opportunity to work with my students and their families. Please feel free to email me or stop by our Counseling Office if you have any questions or concerns.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
