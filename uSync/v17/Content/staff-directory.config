              {
                "contentTypeKey": "9f661a13-f119-496b-b746-26b09b3f2a03",
                "key": "5f94193b-b09e-4ad6-ba06-dbeaf3de690e",
                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Suzie Rizuto"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Rizuto"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Psychology Teacher"
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Social Science"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome! \u00A1Bien Venidos!I\u0027m so excited to be back at Santiago High School. This will be my 9th year at this amazing school and I feel privileged to be a part of the Cavalier team. I feel fortunate and blessed to be teaching AP Psychology all day! A little bit about myself: I grew up in Garden Grove and went to Parkview Elementary, Walton Intermediate, and Garden Grove High School (yes, I know, our rival school). I was extremely involved in high school which scored me a scholarship to to UCI where I double majored in English and Psychology. After I taught summer school at Irvine Intermediate, I was inspired to teach so I then went on to receive my teaching credential from Cal State Fullerton. I have two older brothers, one of who teaches at Grove and I also have an older sister. I am the proud aunt of four amazing nephews and one adorable niece. My interests include hanging out with my baby girl and handsome husband, traveling, eating sushi or eating anything Mexican, dancing, spending time with my husband/family/friends, running, going to the movies, and reading. If you have any questions, come by room 111 and I\u0027ll try to help in any way I can.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
