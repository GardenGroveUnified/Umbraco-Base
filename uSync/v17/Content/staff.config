                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Brandon Croft"
                  },
                  {
                    "alias": "lastName",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Croft"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": ""
                  },
                  {
                    "alias": "department",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Track and Field"
                  },
                  {
                    "alias": "bio",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003EWelcome to Room 505! My name is Mr. Croft and this is my fourth year teaching at Santiago High School and my fourteenth year in the district. I love teaching Santiago\u0027s Seniors in ERWC/English4P. I received my Bachelor\u0027s Degree in English Literature from the University of Redlands in Redlands, California. I also completed my Master\u0027s Degree in Cross-Cultural Teaching. When I am not in the classroom I truly enjoy spending my time as the head coach of the Santiago High School Football Team. My wife and I have been blessed with two wonderful children, our daughter Mika(4) and our son Gunner (1) and we are all excited to be part of the Cavalier Family.\u003C/p\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
