      "values": [
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Payments and physicals"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003EAll payments are collected at the Student Services window.\u003C/li\u003E\u003Cli\u003EA physical is required to take part. Every athlete must be cleared first.\u003C/li\u003E\u003Cli\u003EFree physicals at Exer Urgent Care run 1 May to 31 August.\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003Cstrong\u003EQuestions?\u003C/strong\u003E\u003Cbr\u003EAssistant Principal, Dr. Tran \u0026ndash; \u003Ca href=\u0022mailto:htran@ggusd.us\u0022\u003Ehtran@ggusd.us\u003C/a\u003E\u003Cbr\u003EAthletic Director, Jamie Valladares \u0026ndash; \u003Ca href=\u0022mailto:jvalladares@ggusd.us\u0022\u003Ejvalladares@ggusd.us\u003C/a\u003E\u003Cbr\u003EAthletic Director, Ben Tran \u0026ndash; \u003Ca href=\u0022mailto:btran1@ggusd.us\u0022\u003Ebtran1@ggusd.us\u003C/a\u003E\u003C/p\u003E"
          }
        }
      ]
    }
  ],
