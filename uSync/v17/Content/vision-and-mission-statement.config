                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "fa fa-graduation-cap"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Successful"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u003Cem\u003EGoal 3: Lifelong Success\u003C/em\u003E\u003C/p\u003E\u003Cul\u003E\u003Cli\u003EScholars will be college- and career-ready by completing graduation requirements.\u003C/li\u003E\u003Cli\u003EScholars will demonstrate grit and resilience as they prepare for lifelong success in their intended college and career paths.\u003C/li\u003E\u003C/ul\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "5e5686b5-7aef-442f-8dc0-f8a45bf50405",
                "key": "7e4b7a9f-2001-4b01-9d01-000000000002",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "fa fa-handshake-o"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Civic-Minded"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u003Cem\u003EGoal 2: Personal Skills\u003C/em\u003E\u003C/p\u003E\u003Cul\u003E\u003Cli\u003EScholars will respect individual differences and embrace the community\u0027s cultural diversity.\u003C/li\u003E\u003Cli\u003EScholars will contribute to improving the quality of life within their community.\u003C/li\u003E\u003C/ul\u003E"
                    }
                  },
                  {
                    "alias": "blockVisibility",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "1"
                  }
                ]
              },
              {
                "contentTypeKey": "5e5686b5-7aef-442f-8dc0-f8a45bf50405",
                "key": "7e4b7a9f-2001-4b01-9d01-000000000003",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "fa fa-lightbulb-o"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Critical Thinkers"
                  },
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "Layout": {}
                      },
                      "markup": "\u003Cp\u003E\u003Cem\u003EGoal 1: Academic Skills\u003C/em\u003E\u003C/p\u003E\u003Cul\u003E\u003Cli\u003EScholars will access a rigorous curriculum by developing critical thinking skills to analyze and evaluate information in order to make and communicate informed decisions.\u003C/li\u003E\u003C/ul\u003E"
                    }
                  },
                  {
