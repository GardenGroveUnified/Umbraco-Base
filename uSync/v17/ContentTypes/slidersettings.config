      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Stretch this banner edge-to-edge across the full browser width. Recommended for homepage hero banners.]]></Description>
